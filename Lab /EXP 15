        "import psutil\n",
        "import os\n",
        "import tempfile\n",
        "from pathlib import Path\n",
        "\n",
        "# Capture volatile evidence\n",
        "def capture_volatile_evidence():\n",
        "    processes = [p.info for p in psutil.process_iter(['pid', 'name'])]\n",
        "\n",
        "    return {\n",
        "        \"running_process_count\": len(processes),\n",
        "        \"sample_processes\": processes[:5]\n",
        "    }\n",
        "\n",
        "# Capture non-volatile evidence\n",
        "def capture_nonvolatile_evidence(folder):\n",
        "    files = sorted(os.listdir(folder))\n",
        "\n",
        "    return {\n",
        "        \"disk_files\": files,\n",
        "        \"file_count\": len(files)\n",
        "    }\n",
        "\n",
        "# Create a temporary directory and files for testing non-volatile evidence\n",
        "with tempfile.TemporaryDirectory() as temp_dir:\n",
        "    evidence_dir = Path(temp_dir)\n",
        "    sample_evidence = [\"file1.txt\", \"file2.log\", \"important_doc.pdf\"]\n",
        "\n",
        "    for filename in sample_evidence:\n",
        "        (evidence_dir / filename).touch()\n",
        "\n",
        "    # Capture snapshots\n",
        "    volatile_snapshot = capture_volatile_evidence()\n",
        "    nonvolatile_snapshot = capture_nonvolatile_evidence(evidence_dir)\n",
        "\n",
        "    print(\"Volatile evidence -> running processes:\",\n",
        "          volatile_snapshot[\"running_process_count\"])\n",
        "\n",
        "    print(\"Non-volatile evidence -> disk files:\",\n",
        "          nonvolatile_snapshot)\n",
        "\n",
        "    # Test Cases\n",
        "    def test_experiment2():\n",
        "\n",
        "        assert volatile_snapshot[\"running_process_count\"] > 0\n",
        "\n",
        "        assert isinstance(volatile_snapshot[\"sample_processes\"], list)\n",
        "\n",
        "        assert nonvolatile_snapshot[\"file_count\"] == len(sample_evidence)\n",
        "\n",
        "        snapshot2 = capture_nonvolatile_evidence(evidence_dir)\n",
        "\n",
        "        assert snapshot2 == nonvolatile_snapshot\n",
        "\n",
        "        print(\"\\nExperiment 2: All test cases passed.\")\n",
        "\n",
        "    test_experiment2()\n"
      ]
    }
