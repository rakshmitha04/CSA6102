        "import re\n",
        "from collections import defaultdict\n",
        "\n",
        "print(\"=== Experiment 1.4: Hacking Attack Simulation (Ethical) ===\\n\")\n",
        "\n",
        "# -------------------------------\n",
        "# Simulated Login Attempts\n",
        "# -------------------------------\n",
        "login_attempts = [\n",
        "    (\"192.168.1.10\", \"admin\", \"123456\"),\n",
        "    (\"192.168.1.10\", \"admin\", \"password\"),\n",
        "    (\"192.168.1.10\", \"admin\", \"admin123\"),\n",
        "    (\"192.168.1.10\", \"admin\", \"letmein\"),\n",
        "    (\"192.168.1.10\", \"admin\", \"welcome\"),\n",
        "    (\"192.168.1.20\", \"user\", \"Secure@123\")\n",
        "]\n",
        "\n",
        "# Common weak passwords\n",
        "weak_passwords = [\n",
        "    \"123456\",\n",
        "    \"password\",\n",
        "    \"admin\",\n",
        "    \"admin123\",\n",
        "    \"welcome\",\n",
        "    \"letmein\",\n",
        "    \"qwerty\"\n",
        "]\n",
        "\n",
        "attack_logs = []\n",
        "attempt_counter = defaultdict(int)\n",
        "\n",
        "print(\"----- Brute Force Detection -----\")\n",
        "\n",
        "for ip, username, password in login_attempts:\n",
        "    attempt_counter[ip] += 1\n",
        "\n",
        "    if password in weak_passwords:\n",
        "        attack_logs.append(f\"Weak password used by {username} from {ip}: {password}\")\n",
        "\n",
        "    if attempt_counter[ip] > 3:\n",
        "        attack_logs.append(f\"Possible brute-force attack detected from {ip}\")\n",
        "\n",
        "# -------------------------------\n",
        "# SQL Injection Detection\n",
        "# -------------------------------\n",
        "sql_payloads = [\n",
        "    \"' OR '1'='1\",\n",
        "    \"admin' --\",\n",
        "    \"' UNION SELECT * FROM users --\",\n",
        "    \"SELECT * FROM users\"\n",
        "]\n",
        "\n",
        "sql_pattern = re.compile(\n",
        "    r\"(union|select|drop|insert|delete|update|--|'|\\bor\\b)\",\n",
        "    re.IGNORECASE\n",
        ")\n",
        "\n",
        "print(\"----- SQL Injection Detection -----\")\n",
        "\n",
        "for payload in sql_payloads:\n",
        "    if sql_pattern.search(payload):\n",
        "        attack_logs.append(f\"SQL Injection Pattern Detected: {payload}\")\n",
        "\n",
        "# -------------------------------\n",
        "# Directory Traversal Detection\n",
        "# -------------------------------\n",
        "paths = [\n",
        "    \"../../etc/passwd\",\n",
        "    \"../secret/config.txt\",\n",
        "    \"/home/user/document.txt\",\n",
        "    \"images/photo.png\"\n",
        "]\n",
        "\n",
        "print(\"----- Directory Traversal Detection -----\")\n",
        "\n",
        "for path in paths:\n",
        "    if \"../\" in path or \"..\\\\\" in path:\n",
        "        attack_logs.append(f\"Directory Traversal Attempt: {path}\")\n",
        "\n",
        "# -------------------------------\n",
        "# Print Attack Logs\n",
        "# -------------------------------\n",
        "print(\"\\n===== Attack Pattern Logs =====\")\n",
        "\n",
        "for log in attack_logs:\n",
        "    print(log)\n",
        "\n",
        "# -------------------------------\n",
        "# Vulnerability Report\n",
        "# -------------------------------\n",
        "print(\"\\n===== Vulnerability Classification Report =====\")\n",
        "\n",
        "report = {\n",
        "    \"Brute Force\": 0,\n",
        "    \"Weak Password\": 0,\n",
        "    \"SQL Injection\": 0,\n",
        "    \"Directory Traversal\": 0\n",
        "}\n",
        "\n",
        "for log in attack_logs:\n",
        "    if \"brute-force\" in log:\n",
        "        report[\"Brute Force\"] += 1\n",
        "    elif \"Weak password\" in log:\n",
        "        report[\"Weak Password\"] += 1\n",
        "    elif \"SQL Injection\" in log:\n",
        "        report[\"SQL Injection\"] += 1\n",
        "    elif \"Directory Traversal\" in log:\n",
        "        report[\"Directory Traversal\"] += 1\n",
        "\n",
        "for key, value in report.items():\n",
        "    print(f\"{key}: {value}\")\n",
        "\n",
        "# -------------------------------\n",
        "# WAF Rule Suggestions\n",
        "# -------------------------------\n",
        "print(\"\\n===== WAF Rule Suggestions =====\")\n",
        "\n",
        "print(\"1. Enable rate limiting after 3 failed login attempts.\")\n",
        "print(\"2. Block common SQL keywords (UNION, SELECT, DROP, --).\")\n",
        "print(\"3. Reject requests containing '../' or '..\\\\'.\")\n",
        "print(\"4. Enforce strong password policy.\")\n",
        "print(\"5. Enable account lockout after repeated failures.\")\n",
        "print(\"6. Log suspicious IP addresses for investigation.\")"
      ]
