        "import os\n",
        "\n",
        "# Create a fake JPEG file\n",
        "def make_fake_jpeg(payload: bytes):\n",
        "    return b\"\\xff\\xd8\\xff\" + payload + b\"\\xff\\xd9\"\n",
        "\n",
        "# Simulated deleted JPEG files\n",
        "jpeg1 = make_fake_jpeg(b\"PHOTO_OF_SUSPECT_CAR\")\n",
        "jpeg2 = make_fake_jpeg(b\"CCTV_FRAME_CAPTURE\")\n",
        "\n",
        "# Simulated raw disk containing random data and deleted JPEGs\n",
        "raw_disk_blob = (\n",
        "    os.urandom(30)\n",
        "    + jpeg1\n",
        "    + os.urandom(40)\n",
        "    + jpeg2\n",
        "    + os.urandom(20)\n",
        ")\n",
        "\n",
        "# File carving function\n",
        "def carve_jpegs(blob: bytes):\n",
        "    recovered = []\n",
        "    start_marker = b\"\\xff\\xd8\\xff\"\n",
        "    end_marker = b\"\\xff\\xd9\"\n",
        "\n",
        "    pos = 0\n",
        "    while True:\n",
        "        start = blob.find(start_marker, pos)\n",
        "        if start == -1:\n",
        "            break\n",
        "\n",
        "        end = blob.find(end_marker, start)\n",
        "        if end == -1:\n",
        "            break\n",
        "\n",
        "        end += len(end_marker)\n",
        "        recovered.append(blob[start:end])\n",
        "        pos = end\n",
        "\n",
        "    return recovered\n",
        "\n",
        "# Recover files\n",
        "recovered_files = carve_jpegs(raw_disk_blob)\n",
        "\n",
        "print(\"Recovered\", len(recovered_files), \"file(s) via carving\")\n",
        "\n",
        "# Test Cases\n",
        "def test_experiment8():\n",
        "    assert len(recovered_files) == 2, \\\n",
        "        \"File carving should recover exactly 2 embedded JPEGs\"\n",
        "\n",
        "    assert recovered_files[0] == jpeg1, \\\n",
        "        \"First recovered file must exactly match the original embedded JPEG\"\n",
        "\n",
        "    assert recovered_files[1] == jpeg2, \\\n",
        "        \"Second recovered file must exactly match the original embedded JPEG\"\n",
        "\n",
        "    print(\"Experiment 8: All test cases passed.\")\n",
        "\n",
        "test_experiment8()"
      ]
    }
