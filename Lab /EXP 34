        "import math\n",
        "from collections import Counter\n",
        "\n",
        "def shannon_entropy(s):\n",
        "    \"\"\"\n",
        "    Calculate the Shannon entropy of a string.\n",
        "    \"\"\"\n",
        "    if not s:\n",
        "        return 0.0\n",
        "\n",
        "    counts = Counter(s)\n",
        "    length = len(s)\n",
        "\n",
        "    entropy = -sum(\n",
        "        (count / length) * math.log2(count / length)\n",
        "        for count in counts.values()\n",
        "    )\n",
        "\n",
        "    return entropy\n",
        "\n",
        "\n",
        "def detect_dns_tunneling(queries, length_threshold=20, entropy_threshold=3.5):\n",
        "    \"\"\"\n",
        "    Detect possible DNS tunneling based on\n",
        "    long and high-entropy subdomains.\n",
        "    \"\"\"\n",
        "\n",
        "    flagged = []\n",
        "\n",
        "    for query in queries:\n",
        "\n",
        "        label = query.split(\".\")[0]\n",
        "\n",
        "        entropy = shannon_entropy(label)\n",
        "\n",
        "        if len(label) >= length_threshold and entropy >= entropy_threshold:\n",
        "\n",
        "            flagged.append({\n",
        "                \"query\": query,\n",
        "                \"label_length\": len(label),\n",
        "                \"entropy\": round(entropy, 2)\n",
        "            })\n",
        "\n",
        "    return flagged"
      ]
