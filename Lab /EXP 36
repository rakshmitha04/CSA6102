        "# Experiment 8: Mobile SMS Deleted-Message Recovery Simulator\n",
        "\n",
        "def recover_deleted_messages(sms_table):\n",
        "    \"\"\"\n",
        "    Return deleted SMS messages that have not been overwritten.\n",
        "    \"\"\"\n",
        "    recoverable = []\n",
        "\n",
        "    for row in sms_table:\n",
        "        if row[\"is_deleted\"] == True and row[\"overwritten\"] == False:\n",
        "            recoverable.append(row)\n",
        "\n",
        "    return recoverable\n",
        "\n",
        "\n",
        "def summarize_table(sms_table):\n",
        "    \"\"\"\n",
        "    Count active, recoverable, and permanently lost messages.\n",
        "    \"\"\"\n",
        "    active = []\n",
        "    lost = []\n",
        "\n",
        "    for row in sms_table:\n",
        "        if row[\"is_deleted\"] == False:\n",
        "            active.append(row)\n",
        "        elif row[\"overwritten\"] == True:\n",
        "            lost.append(row)\n",
        "\n",
        "    recoverable = recover_deleted_messages(sms_table)\n",
        "\n",
        "    return {\n",
        "        \"active\": len(active),\n",
        "        \"recoverable\": len(recoverable),\n",
        "        \"permanently_lost\": len(lost)\n",
        "    }\n",
        "\n",
        "\n",
        "def test_experiment8():\n",
        "\n",
        "    sms_table = [\n",
        "\n",
        "        {\n",
        "            \"rowid\": 1,\n",
        "            \"address\": \"+1-555-0101\",\n",
        "            \"body\": \"See you at 6pm\",\n",
        "            \"date\": \"2026-01-01\",\n",
        "            \"is_deleted\": False,\n",
        "            \"overwritten\": False\n",
        "        },\n",
        "\n",
        "        {\n",
        "            \"rowid\": 2,\n",
        "            \"address\": \"+1-555-0199\",\n",
        "            \"body\": \"Transfer the funds now, delete after reading\",\n",
        "            \"date\": \"2026-01-02\",\n",
        "            \"is_deleted\": True,\n",
        "            \"overwritten\": False\n",
        "        },\n",
        "\n",
        "        {\n",
        "            \"rowid\": 3,\n",
        "            \"address\": \"+1-555-0150\",\n",
        "            \"body\": \"Old spam message\",\n",
        "            \"date\": \"2025-06-01\",\n",
        "            \"is_deleted\": True,\n",
        "            \"overwritten\": True\n",
        "        }\n",
        "\n",
        "    ]\n",
        "\n",
        "    recoverable = recover_deleted_messages(sms_table)\n",
        "\n",
        "    print(\"Recoverable Messages:\")\n",
        "    for msg in recoverable:\n",
        "        print(msg)\n",
        "\n",
        "    assert len(recoverable) == 1\n",
        "    assert recoverable[0][\"rowid\"] == 2\n",
        "    assert \"Transfer the funds\" in recoverable[0][\"body\"]\n",
        "\n",
        "    summary = summarize_table(sms_table)\n",
        "\n",
        "    print(\"\\nSummary:\")\n",
        "    print(summary)\n",
        "\n",
        "    assert summary == {\n",
        "        \"active\": 1,\n",
        "        \"recoverable\": 1,\n",
        "        \"permanently_lost\": 1\n",
        "    }\n",
        "\n",
        "    print(\"\\nAll test cases passed.\")\n",
        "\n",
        "\n",
        "test_experiment8()"
      ]
