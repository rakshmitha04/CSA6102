      "source": [
        "# Cluster size (4 KB)\n",
        "CLUSTER_SIZE = 4096\n",
        "\n",
        "# Function to calculate allocated space and slack space\n",
        "def calculate_slack_space(file_size, cluster_size=CLUSTER_SIZE):\n",
        "    clusters_needed = -(-file_size // cluster_size)  # Ceiling division\n",
        "    allocated_space = clusters_needed * cluster_size\n",
        "    slack_space = allocated_space - file_size\n",
        "    return allocated_space, slack_space\n",
        "\n",
        "# Example file\n",
        "file_size = 5000  # bytes\n",
        "\n",
        "allocated, slack = calculate_slack_space(file_size)\n",
        "\n",
        "print(f\"File size: {file_size} bytes -> allocated: {allocated} bytes, slack space: {slack} bytes\")\n",
        "\n",
        "# Test Cases\n",
        "def test_experiment10():\n",
        "    assert allocated == 8192, \\\n",
        "        \"5000 bytes needs 2 clusters of 4096 bytes = 8192 bytes allocated\"\n",
        "\n",
        "    assert slack == 8192 - 5000, \\\n",
        "        \"Slack space should be the unused remainder of the last cluster\"\n",
        "\n",
        "    allocated2, slack2 = calculate_slack_space(4096)\n",
        "\n",
        "    assert slack2 == 0, \\\n",
        "        \"A file that exactly fills a cluster should have zero slack space\"\n",
        "\n",
        "    print(\"Experiment 10: All test cases passed.\")\n",
        "\n",
        "test_experiment10()"
      ]
    }
