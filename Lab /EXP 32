        "from datetime import datetime\n",
        "\n",
        "TS_FMT = \"%Y-%m-%d %H:%M:%S\"\n",
        "\n",
        "def detect_timestomping(file_meta, change_gap_minutes=60):\n",
        "\n",
        "    modified = datetime.strptime(file_meta[\"modified\"], TS_FMT)\n",
        "    accessed = datetime.strptime(file_meta[\"accessed\"], TS_FMT)\n",
        "    changed = datetime.strptime(file_meta[\"changed\"], TS_FMT)\n",
        "    born = datetime.strptime(file_meta[\"born\"], TS_FMT)\n",
        "\n",
        "    reasons = []\n",
        "\n",
        "    if modified < born:\n",
        "        reasons.append(\"Modified time is earlier than Born (creation) time\")\n",
        "\n",
        "    if accessed < born:\n",
        "        reasons.append(\"Accessed time is earlier than Born (creation) time\")\n",
        "\n",
        "    gap_minutes = abs((changed - modified).total_seconds()) / 60\n",
        "\n",
        "    if changed > modified and gap_minutes > change_gap_minutes:\n",
        "        reasons.append(\n",
        "            f\"MFT Changed time is {gap_minutes:.0f} minutes after Modified time - metadata may have been altered after the fact\"\n",
        "        )\n",
        "\n",
        "    return len(reasons) > 0, reasons"
      ]
