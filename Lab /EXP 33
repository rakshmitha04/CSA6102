        "from datetime import datetime, timedelta\n",
        "\n",
        "PKT_FMT = \"%Y-%m-%d %H:%M:%S\"\n",
        "\n",
        "def detect_port_scan(packets, port_threshold=10, window_seconds=30):\n",
        "    \"\"\"\n",
        "    Detect (src_ip -> dst_ip) pairs that contact\n",
        "    port_threshold or more distinct destination ports\n",
        "    within window_seconds.\n",
        "    \"\"\"\n",
        "\n",
        "    packets = sorted(\n",
        "        packets,\n",
        "        key=lambda p: datetime.strptime(p[\"timestamp\"], PKT_FMT)\n",
        "    )\n",
        "\n",
        "    by_pair = {}\n",
        "\n",
        "    for packet in packets:\n",
        "        key = (packet[\"src_ip\"], packet[\"dst_ip\"])\n",
        "        by_pair.setdefault(key, []).append(packet)\n",
        "\n",
        "    results = {}\n",
        "\n",
        "    for key, pkts in by_pair.items():\n",
        "\n",
        "        for i in range(len(pkts)):\n",
        "\n",
        "            start = datetime.strptime(pkts[i][\"timestamp\"], PKT_FMT)\n",
        "            end = start + timedelta(seconds=window_seconds)\n",
        "\n",
        "            ports_in_window = set()\n",
        "\n",
        "            for pkt in pkts:\n",
        "                t = datetime.strptime(pkt[\"timestamp\"], PKT_FMT)\n",
        "\n",
        "                if start <= t <= end:\n",
        "                    ports_in_window.add(pkt[\"dst_port\"])\n",
        "\n",
        "            if len(ports_in_window) >= port_threshold:\n",
        "\n",
        "                results[key] = {\n",
        "                    \"distinct_ports\": len(ports_in_window),\n",
        "                    \"ports\": sorted(list(ports_in_window))\n",
        "                }\n",
        "\n",
        "                break\n",
        "\n",
        "    return results"
      ]
