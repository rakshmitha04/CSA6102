        "import os\n",
        "import hashlib\n",
        "\n",
        "# Create a simulated storage device (1 KB)\n",
        "original_path = \"original_evidence.bin\"\n",
        "\n",
        "with open(original_path, \"wb\") as f:\n",
        "    f.write(os.urandom(1024))\n",
        "\n",
        "# Bit Stream Copy\n",
        "def bit_stream_copy(src_path, dst_path):\n",
        "    with open(src_path, \"rb\") as src, open(dst_path, \"wb\") as dst:\n",
        "        dst.write(src.read())\n",
        "\n",
        "copy_path = \"bitstream_copy.bin\"\n",
        "bit_stream_copy(original_path, copy_path)\n",
        "\n",
        "# SHA-256 Hash Function\n",
        "def sha256_of_file(path):\n",
        "    with open(path, \"rb\") as f:\n",
        "        return hashlib.sha256(f.read()).hexdigest()\n",
        "\n",
        "original_hash = sha256_of_file(original_path)\n",
        "copy_hash = sha256_of_file(copy_path)\n",
        "\n",
        "print(\"Original hash:\", original_hash)\n",
        "print(\"Copy hash:    \", copy_hash)\n",
        "\n",
        "# Test Cases\n",
        "def test_experiment6():\n",
        "    assert os.path.getsize(original_path) == os.path.getsize(copy_path), \\\n",
        "        \"Bit stream copy must match original size exactly\"\n",
        "\n",
        "    assert original_hash == copy_hash, \\\n",
        "        \"Hashes must match, proving the copy is forensically identical\"\n",
        "\n",
        "    print(\"Experiment 6: All test cases passed.\")\n",
        "\n",
        "test_experiment6()"
      ]
