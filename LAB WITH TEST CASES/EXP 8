        "from collections import Counter, defaultdict\n",
        "from datetime import datetime\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# BASELINE NETWORK RECORDS\n",
        "# Format:\n",
        "# (Time, Destination, Protocol, Transfer Volume in MB)\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "baseline = [\n",
        "    (\"09:00\", \"google.com\", \"HTTPS\", 20),\n",
        "    (\"09:15\", \"google.com\", \"HTTPS\", 25),\n",
        "    (\"09:30\", \"google.com\", \"HTTPS\", 18),\n",
        "    (\"10:00\", \"microsoft.com\", \"HTTPS\", 30),\n",
        "    (\"10:20\", \"microsoft.com\", \"HTTPS\", 25),\n",
        "    (\"11:00\", \"github.com\", \"HTTPS\", 15),\n",
        "    (\"11:30\", \"github.com\", \"HTTPS\", 20),\n",
        "    (\"12:00\", \"google.com\", \"HTTPS\", 22),\n",
        "]\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# NEW DATASET TO INVESTIGATE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "new_records = [\n",
        "    (\"09:10\", \"google.com\", \"HTTPS\", 24),       # Normal\n",
        "    (\"09:45\", \"unknown-site.com\", \"HTTPS\", 20), # New destination\n",
        "    (\"10:30\", \"microsoft.com\", \"FTP\", 25),      # Protocol anomaly\n",
        "    (\"02:30\", \"github.com\", \"HTTPS\", 18),       # Unusual time\n",
        "    (\"11:45\", \"google.com\", \"HTTPS\", 500),      # Large transfer\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CREATE BASELINE PROFILE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def create_baseline(records):\n",
        "\n",
        "    destinations = Counter()\n",
        "    protocols = Counter()\n",
        "    volumes = []\n",
        "    hours = []\n",
        "\n",
        "    for time, destination, protocol, volume in records:\n",
        "\n",
        "        destinations[destination] += 1\n",
        "        protocols[protocol] += 1\n",
        "        volumes.append(volume)\n",
        "\n",
        "        hour = int(time.split(\":\")[0])\n",
        "        hours.append(hour)\n",
        "\n",
        "    profile = {\n",
        "        \"destinations\": set(destinations.keys()),\n",
        "        \"protocols\": set(protocols.keys()),\n",
        "        \"max_destination_frequency\": max(destinations.values()),\n",
        "        \"average_volume\": sum(volumes) / len(volumes),\n",
        "        \"max_volume\": max(volumes),\n",
        "        \"normal_hours\": set(hours)\n",
        "    }\n",
        "\n",
        "    return profile\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ANALYZE NEW DATASET\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def analyze_records(records, profile):\n",
        "\n",
        "    anomalies = []\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"OUTBOUND TRAFFIC DEVIATION ANALYSIS\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    for record in records:\n",
        "\n",
        "        time, destination, protocol, volume = record\n",
        "        violations = []\n",
        "\n",
        "        hour = int(time.split(\":\")[0])\n",
        "\n",
        "        # Check destination\n",
        "        if destination not in profile[\"destinations\"]:\n",
        "            violations.append(\n",
        "                \"Destination not present in baseline\"\n",
        "            )\n",
        "\n",
        "        # Check protocol\n",
        "        if protocol not in profile[\"protocols\"]:\n",
        "            violations.append(\n",
        "                \"Protocol not present in baseline\"\n",
        "            )\n",
        "\n",
        "        # Check connection time\n",
        "        if hour not in profile[\"normal_hours\"]:\n",
        "            violations.append(\n",
        "                \"Connection time outside baseline hours\"\n",
        "            )\n",
        "\n",
        "        # Check transfer volume\n",
        "        if volume > profile[\"max_volume\"] * 2:\n",
        "            violations.append(\n",
        "                \"Transfer volume exceeds baseline range\"\n",
        "            )\n",
        "\n",
        "        # Store anomaly\n",
        "        if violations:\n",
        "            anomalies.append((record, violations))\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # DISPLAY FINDINGS\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    if not anomalies:\n",
        "        print(\"\\nNo deviations detected.\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"\\nANOMALOUS CONNECTIONS\")\n",
        "        print(\"-\" * 75)\n",
        "\n",
        "        for record, violations in anomalies:\n",
        "\n",
        "            time, destination, protocol, volume = record\n",
        "\n",
        "            print(f\"\\nTime        : {time}\")\n",
        "            print(f\"Destination : {destination}\")\n",
        "            print(f\"Protocol    : {protocol}\")\n",
        "            print(f\"Volume      : {volume} MB\")\n",
        "\n",
        "            print(\"Baseline characteristic violated:\")\n",
        "\n",
        "            for violation in violations:\n",
        "                print(f\"  - {violation}\")\n",
        "\n",
        "    return anomalies\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"NETWORK OUTBOUND TRAFFIC PROFILING\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "# Establish normal profile\n",
        "profile = create_baseline(baseline)\n",
        "\n",
        "print(\"\\nBASELINE PROFILE\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "print(\n",
        "    \"Normal destinations :\",\n",
        "    \", \".join(sorted(profile[\"destinations\"]))\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Normal protocols    :\",\n",
        "    \", \".join(sorted(profile[\"protocols\"]))\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Normal connection hours:\",\n",
        "    \", \".join(str(h) for h in sorted(profile[\"normal_hours\"]))\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Average transfer volume : {profile['average_volume']:.2f} MB\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Maximum transfer volume : {profile['max_volume']} MB\"\n",
        ")\n",
        "\n",
        "\n",
        "# Analyze second dataset\n",
        "anomalies = analyze_records(new_records, profile)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FINAL SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"FORENSIC SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(f\"Baseline records analyzed : {len(baseline)}\")\n",
        "print(f\"New records analyzed      : {len(new_records)}\")\n",
        "print(f\"Anomalies detected        : {len(anomalies)}\")\n",
        "\n",
        "if anomalies:\n",
        "    print(\"\\nResult: Deviations from normal outbound traffic detected.\")\n",
        "else:\n",
        "    print(\"\\nResult: Traffic is consistent with the baseline.\")\n",
