        "from datetime import datetime\n",
        "from collections import defaultdict\n",
        "\n",
        "# Simulated application activity log\n",
        "activity_log = [\n",
        "    (\"report.docx\", \"Alice\", \"MS Word\", \"2026-08-29 09:15:00\", \"Opened\"),\n",
        "    (\"evidence.xlsx\", \"Bob\", \"MS Excel\", \"2026-08-29 09:30:00\", \"Opened\"),\n",
        "    (\"report.docx\", \"Bob\", \"MS Word\", \"2026-08-29 10:00:00\", \"Edited\"),\n",
        "    (\"case_notes.txt\", \"Alice\", \"Notepad\", \"2026-08-29 10:20:00\", \"Opened\"),\n",
        "    (\"evidence.xlsx\", \"Charlie\", \"MS Excel\", \"2026-08-29 10:45:00\", \"Edited\"),\n",
        "    (\"photo.jpg\", \"Alice\", \"Photos\", \"2026-08-29 11:00:00\", \"Viewed\"),\n",
        "    (\"report.docx\", \"Alice\", \"MS Word\", \"2026-08-29 11:30:00\", \"Saved\"),\n",
        "    (\"evidence.xlsx\", \"Bob\", \"MS Excel\", \"2026-08-29 12:00:00\", \"Opened\")\n",
        "]\n",
        "\n",
        "# Display all extracted activity records\n",
        "print(\"RECENTLY USED DOCUMENT ANALYSIS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"\\nDocument\\tUser\\tApplication\\t\\tAccess Time\\t\\tActivity\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "for record in activity_log:\n",
        "    document, user, application, access_time, activity = record\n",
        "\n",
        "    print(f\"{document}\\t{user}\\t{application}\\t{access_time}\\t{activity}\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Find most recently accessed documents\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\nMOST RECENTLY ACCESSED DOCUMENTS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "document_times = {}\n",
        "\n",
        "for record in activity_log:\n",
        "    document, user, application, access_time, activity = record\n",
        "\n",
        "    time = datetime.strptime(access_time, \"%Y-%m-%d %H:%M:%S\")\n",
        "\n",
        "    if document not in document_times or time > document_times[document]:\n",
        "        document_times[document] = time\n",
        "\n",
        "# Sort documents by most recent access\n",
        "recent_documents = sorted(\n",
        "    document_times.items(),\n",
        "    key=lambda x: x[1],\n",
        "    reverse=True\n",
        ")\n",
        "\n",
        "for document, time in recent_documents:\n",
        "    print(f\"{document:20} Last Accessed: {time}\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Identify documents accessed by multiple users\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\nDOCUMENTS ACCESSED BY MORE THAN ONE USER\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "document_users = defaultdict(set)\n",
        "\n",
        "for record in activity_log:\n",
        "    document, user, application, access_time, activity = record\n",
        "    document_users[document].add(user)\n",
        "\n",
        "found = False\n",
        "\n",
        "for document, users in document_users.items():\n",
        "\n",
        "    if len(users) > 1:\n",
        "        found = True\n",
        "\n",
        "        print(f\"\\nDocument: {document}\")\n",
        "        print(\"Users:\", \", \".join(sorted(users)))\n",
        "        print(\"Number of users:\", len(users))\n",
        "\n",
        "if not found:\n",
        "    print(\"No documents were accessed by multiple users.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Final forensic summary\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\nFORENSIC SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Total activity records :\", len(activity_log))\n",
        "print(\"Total documents        :\", len(document_users))\n",
        "\n",
        "print(\"\\nMost recently accessed:\")\n",
        "print(f\"{recent_documents[0][0]} at {recent_documents[0][1]}\")\n",
        "\n",
        "print(\"\\nDocuments accessed by multiple users:\")\n",
        "\n",
        "for document, users in document_users.items():\n",
        "    if len(users) > 1:\n",
        "        print(f\"- {document}: {', '.join(sorted(users))}\")"
