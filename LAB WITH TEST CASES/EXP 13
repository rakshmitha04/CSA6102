        "import socket\n",
        "from collections import defaultdict\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# READ DOMAINS FROM TEXT FILE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def read_domains(filename):\n",
        "\n",
        "    domains = []\n",
        "\n",
        "    with open(filename, \"r\") as file:\n",
        "\n",
        "        for line in file:\n",
        "\n",
        "            domain = line.strip()\n",
        "\n",
        "            # Ignore blank lines\n",
        "            if domain:\n",
        "                domains.append(domain)\n",
        "\n",
        "    return domains\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# RESOLVE DOMAIN\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def resolve_domain(domain):\n",
        "\n",
        "    try:\n",
        "\n",
        "        # Get all IPv4 addresses\n",
        "        addresses = socket.gethostbyname_ex(domain)[2]\n",
        "\n",
        "        # Remove duplicate IP addresses\n",
        "        return sorted(set(addresses))\n",
        "\n",
        "    except socket.gaierror:\n",
        "        return []\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DNS INVESTIGATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def investigate(domains):\n",
        "\n",
        "    results = {}\n",
        "    ip_to_domains = defaultdict(list)\n",
        "    failed_domains = []\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(\"DNS INVESTIGATION TOOL\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    # Resolve each domain\n",
        "    for domain in domains:\n",
        "\n",
        "        ips = resolve_domain(domain)\n",
        "\n",
        "        results[domain] = ips\n",
        "\n",
        "        if ips:\n",
        "\n",
        "            print(f\"\\nDomain : {domain}\")\n",
        "\n",
        "            print(\"IP Addresses:\")\n",
        "            for ip in ips:\n",
        "                print(f\"  - {ip}\")\n",
        "\n",
        "                # Map IP to domain\n",
        "                ip_to_domains[ip].append(domain)\n",
        "\n",
        "        else:\n",
        "\n",
        "            failed_domains.append(domain)\n",
        "\n",
        "            print(f\"\\nDomain : {domain}\")\n",
        "            print(\"Status : RESOLUTION FAILED\")\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # SHARED IP ADDRESSES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"DOMAINS SHARING AN IP ADDRESS\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    shared_found = False\n",
        "\n",
        "    for ip, domain_list in ip_to_domains.items():\n",
        "\n",
        "        # More than one domain uses the same IP\n",
        "        if len(domain_list) > 1:\n",
        "\n",
        "            shared_found = True\n",
        "\n",
        "            print(f\"\\nIP Address : {ip}\")\n",
        "            print(\"Domains:\")\n",
        "\n",
        "            for domain in sorted(domain_list):\n",
        "                print(f\"  - {domain}\")\n",
        "\n",
        "    if not shared_found:\n",
        "        print(\"\\nNo shared IP addresses detected.\")\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # FAILED RESOLUTIONS\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"DOMAINS WITH FAILED RESOLUTION\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    if failed_domains:\n",
        "\n",
        "        for domain in failed_domains:\n",
        "            print(f\"- {domain}\")\n",
        "\n",
        "    else:\n",
        "        print(\"None\")\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # COMPACT SUMMARY\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    successful = len(domains) - len(failed_domains)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"RECONNAISSANCE SUMMARY\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    print(f\"Domains analyzed     : {len(domains)}\")\n",
        "    print(f\"Successfully resolved: {successful}\")\n",
        "    print(f\"Resolution failures  : {len(failed_domains)}\")\n",
        "    print(f\"Unique IP addresses  : {len(ip_to_domains)}\")\n",
        "\n",
        "    print(\"\\nDomain → IP Summary\")\n",
        "    print(\"-\" * 70)\n",
        "\n",
        "    for domain, ips in results.items():\n",
        "\n",
        "        if ips:\n",
        "            print(\n",
        "                f\"{domain:<30} \"\n",
        "                f\"{', '.join(ips)}\"\n",
        "            )\n",
        "        else:\n",
        "            print(\n",
        "                f\"{domain:<30} \"\n",
        "                f\"RESOLUTION FAILED\"\n",
        "            )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "INPUT_FILE = \"domains.txt\"\n",
        "\n",
        "try:\n",
        "\n",
        "    domains = read_domains(INPUT_FILE)\n",
        "\n",
        "    if not domains:\n",
        "        print(\"No domains found in the input file.\")\n",
        "\n",
        "    else:\n",
        "        investigate(domains)\n",
        "\n",
        "except FileNotFoundError:\n",
        "\n",
        "    print(f\"Error: {INPUT_FILE} was not found.\")\n",
        "\n",
        "except Exception as e:\n",
        "\n",
        "    print(f\"Error: {e}\")"
      ]
    }
  ]
