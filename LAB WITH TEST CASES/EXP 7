        "from collections import defaultdict\n",
        "from datetime import datetime\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SIMULATED AUTHENTICATION EVENT LOG\n",
        "# Format:\n",
        "# (Time, User, Source IP, Result)\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "events = [\n",
        "    (\"2026-08-29 09:10:00\", \"alice\", \"192.168.1.10\", \"FAILURE\"),\n",
        "    (\"2026-08-29 09:11:00\", \"alice\", \"192.168.1.10\", \"FAILURE\"),\n",
        "    (\"2026-08-29 09:12:00\", \"alice\", \"192.168.1.10\", \"FAILURE\"),\n",
        "    (\"2026-08-29 09:13:00\", \"alice\", \"192.168.1.10\", \"SUCCESS\"),\n",
        "\n",
        "    (\"2026-08-29 02:15:00\", \"bob\", \"192.168.1.20\", \"SUCCESS\"),\n",
        "\n",
        "    (\"2026-08-29 02:20:00\", \"bob\", \"10.10.10.5\", \"FAILURE\"),\n",
        "    (\"2026-08-29 02:21:00\", \"bob\", \"10.10.10.5\", \"FAILURE\"),\n",
        "    (\"2026-08-29 02:22:00\", \"bob\", \"10.10.10.5\", \"FAILURE\"),\n",
        "\n",
        "    (\"2026-08-29 14:00:00\", \"charlie\", \"172.16.0.5\", \"FAILURE\"),\n",
        "    (\"2026-08-29 14:02:00\", \"charlie\", \"172.16.0.5\", \"SUCCESS\"),\n",
        "\n",
        "    (\"2026-08-29 15:00:00\", \"alice\", \"192.168.1.10\", \"SUCCESS\")\n",
        "]\n",
        "\n",
        "# Configuration\n",
        "FAILURE_THRESHOLD = 3\n",
        "UNUSUAL_START = 0\n",
        "UNUSUAL_END = 5\n",
        "NEW_SOURCE_THRESHOLD = 2\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Display all events\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"AUTHENTICATION EVENT LOG ANALYZER\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for event in events:\n",
        "    timestamp, user, source_ip, result = event\n",
        "\n",
        "    print(\n",
        "        f\"{timestamp} | \"\n",
        "        f\"User: {user:<8} | \"\n",
        "        f\"Source: {source_ip:<15} | \"\n",
        "        f\"Result: {result}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FINDING 1:\n",
        "# Successful login after numerous failures\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\n1. SUCCESS AFTER MULTIPLE FAILURES\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "failures = defaultdict(list)\n",
        "findings = []\n",
        "\n",
        "for event in events:\n",
        "\n",
        "    timestamp, user, source_ip, result = event\n",
        "\n",
        "    if result == \"FAILURE\":\n",
        "        failures[user].append(event)\n",
        "\n",
        "    elif result == \"SUCCESS\":\n",
        "\n",
        "        if len(failures[user]) >= FAILURE_THRESHOLD:\n",
        "\n",
        "            print(f\"\\nANOMALY: {user}\")\n",
        "            print(\"Successful login occurred after multiple failures.\")\n",
        "\n",
        "            print(\"\\nSupporting Records:\")\n",
        "\n",
        "            for record in failures[user]:\n",
        "                print(\" \", record)\n",
        "\n",
        "            print(\" \", event)\n",
        "\n",
        "            findings.append(\n",
        "                f\"{user}: Success after {len(failures[user])} failures\"\n",
        "            )\n",
        "\n",
        "        # Reset failure count after successful login\n",
        "        failures[user] = []\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FINDING 2:\n",
        "# Login attempts at unusual times\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\n2. UNUSUAL LOGIN TIMES\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for event in events:\n",
        "\n",
        "    timestamp, user, source_ip, result = event\n",
        "\n",
        "    time = datetime.strptime(\n",
        "        timestamp,\n",
        "        \"%Y-%m-%d %H:%M:%S\"\n",
        "    )\n",
        "\n",
        "    hour = time.hour\n",
        "\n",
        "    if UNUSUAL_START <= hour < UNUSUAL_END:\n",
        "\n",
        "        print(f\"\\nANOMALY: Unusual login time\")\n",
        "        print(f\"User      : {user}\")\n",
        "        print(f\"Source IP : {source_ip}\")\n",
        "        print(f\"Time      : {timestamp}\")\n",
        "        print(f\"Result    : {result}\")\n",
        "        print(\"Supporting Record:\")\n",
        "        print(\" \", event)\n",
        "\n",
        "        findings.append(\n",
        "            f\"{user}: Login at unusual time {timestamp}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FINDING 3:\n",
        "# Repeated authentication activity from new source addresses\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\n3. REPEATED ACTIVITY FROM SOURCE ADDRESSES\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "user_sources = defaultdict(set)\n",
        "source_events = defaultdict(list)\n",
        "\n",
        "for event in events:\n",
        "\n",
        "    timestamp, user, source_ip, result = event\n",
        "\n",
        "    # Store event for each source\n",
        "    source_events[(user, source_ip)].append(event)\n",
        "\n",
        "    # Check whether source was previously seen\n",
        "    if source_ip not in user_sources[user]:\n",
        "\n",
        "        user_sources[user].add(source_ip)\n",
        "\n",
        "        # If repeated events occur from this source,\n",
        "        # flag the activity.\n",
        "        if len(source_events[(user, source_ip)]) >= NEW_SOURCE_THRESHOLD:\n",
        "\n",
        "            print(f\"\\nANOMALY: New/repeated source activity\")\n",
        "            print(f\"User      : {user}\")\n",
        "            print(f\"Source IP : {source_ip}\")\n",
        "\n",
        "            print(\"\\nSupporting Records:\")\n",
        "\n",
        "            for record in source_events[(user, source_ip)]:\n",
        "                print(\" \", record)\n",
        "\n",
        "            findings.append(\n",
        "                f\"{user}: Repeated authentication from {source_ip}\"\n",
        "            )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# IMPROVED CHECK FOR REPEATED SOURCE ACTIVITY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\n4. SOURCE ADDRESS ACTIVITY SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for (user, source_ip), records in source_events.items():\n",
        "\n",
        "    if len(records) >= NEW_SOURCE_THRESHOLD:\n",
        "\n",
        "        print(f\"\\nUser      : {user}\")\n",
        "        print(f\"Source IP : {source_ip}\")\n",
        "        print(f\"Attempts  : {len(records)}\")\n",
        "\n",
        "        print(\"Event Records:\")\n",
        "\n",
        "        for record in records:\n",
        "            print(\" \", record)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FINAL SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\nFORENSIC FINDINGS SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(f\"Total events analyzed : {len(events)}\")\n",
        "print(f\"Total findings        : {len(findings)}\")\n",
        "\n",
        "for number, finding in enumerate(findings, 1):\n",
        "    print(f\"{number}. {finding}\")\n",
        "\n",
        "print(\"\\nAnalysis completed.\")"
      ]
    }
