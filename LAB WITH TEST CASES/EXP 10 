      "source": [
        "# ---------------------------------------------------------\n",
        "# FORENSIC EXAMINATION SUMMARY GENERATOR\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "INPUT_FILE = \"investigator_notes.txt\"\n",
        "OUTPUT_FILE = \"forensic_summary.txt\"\n",
        "\n",
        "\n",
        "def parse_notes(filename):\n",
        "\n",
        "    sections = {\n",
        "        \"OBSERVATIONS\": [],\n",
        "        \"EVIDENCE_REFERENCES\": [],\n",
        "        \"EXAMINATION_STEPS\": [],\n",
        "        \"FINDINGS\": []\n",
        "    }\n",
        "\n",
        "    case_details = {}\n",
        "\n",
        "    current_section = None\n",
        "\n",
        "    with open(filename, \"r\", encoding=\"utf-8\") as file:\n",
        "\n",
        "        for line in file:\n",
        "\n",
        "            line = line.strip()\n",
        "\n",
        "            # Ignore blank lines\n",
        "            if not line:\n",
        "                continue\n",
        "\n",
        "            # Case information\n",
        "            if \":\" in line and not line.startswith(\n",
        "                (\"Observation:\",\n",
        "                 \"Evidence:\",\n",
        "                 \"Step:\",\n",
        "                 \"Finding:\")\n",
        "            ):\n",
        "                key, value = line.split(\":\", 1)\n",
        "                case_details[key.strip()] = value.strip()\n",
        "\n",
        "            # Section heading\n",
        "            elif line.startswith(\"[\") and line.endswith(\"]\"):\n",
        "                current_section = line[1:-1]\n",
        "\n",
        "            # Section content\n",
        "            elif current_section in sections:\n",
        "                sections[current_section].append(line)\n",
        "\n",
        "    return case_details, sections\n",
        "\n",
        "\n",
        "def create_summary(case_details, sections):\n",
        "\n",
        "    summary = []\n",
        "\n",
        "    summary.append(\"=\" * 70)\n",
        "    summary.append(\"FORENSIC EXAMINATION SUMMARY\")\n",
        "    summary.append(\"=\" * 70)\n",
        "\n",
        "    # Case information\n",
        "    summary.append(\"\\n1. CASE INFORMATION\")\n",
        "    summary.append(\"-\" * 70)\n",
        "\n",
        "    for key, value in case_details.items():\n",
        "        summary.append(f\"{key}: {value}\")\n",
        "\n",
        "    # Observations\n",
        "    summary.append(\"\\n2. OBSERVATIONS\")\n",
        "    summary.append(\"-\" * 70)\n",
        "\n",
        "    for observation in sections[\"OBSERVATIONS\"]:\n",
        "        summary.append(observation)\n",
        "\n",
        "    # Evidence references\n",
        "    summary.append(\"\\n3. EVIDENCE REFERENCES\")\n",
        "    summary.append(\"-\" * 70)\n",
        "\n",
        "    for evidence in sections[\"EVIDENCE_REFERENCES\"]:\n",
        "        summary.append(evidence)\n",
        "\n",
        "    # Examination steps\n",
        "    summary.append(\"\\n4. EXAMINATION STEPS\")\n",
        "    summary.append(\"-\" * 70)\n",
        "\n",
        "    for step in sections[\"EXAMINATION_STEPS\"]:\n",
        "        summary.append(step)\n",
        "\n",
        "    # Findings\n",
        "    summary.append(\"\\n5. FINDINGS\")\n",
        "    summary.append(\"-\" * 70)\n",
        "\n",
        "    for finding in sections[\"FINDINGS\"]:\n",
        "        summary.append(finding)\n",
        "\n",
        "    # Conclusion\n",
        "    summary.append(\"\\n6. EXAMINATION CONCLUSION\")\n",
        "    summary.append(\"-\" * 70)\n",
        "    summary.append(\n",
        "        \"The examination was performed on the evidence references \"\n",
        "        \"listed above. The observations, examination steps, and \"\n",
        "        \"findings are reproduced from the investigator notes \"\n",
        "        \"without changing the recorded evidence values.\"\n",
        "    )\n",
        "\n",
        "    summary.append(\"\\n\" + \"=\" * 70)\n",
        "\n",
        "    return \"\\n\".join(summary)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"FORENSIC SUMMARY GENERATOR\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "try:\n",
        "\n",
        "    case_details, sections = parse_notes(INPUT_FILE)\n",
        "\n",
        "    report = create_summary(\n",
        "        case_details,\n",
        "        sections\n",
        "    )\n",
        "\n",
        "    # Display report\n",
        "    print(\"\\n\" + report)\n",
        "\n",
        "    # Save report\n",
        "    with open(\n",
        "        OUTPUT_FILE,\n",
        "        \"w\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as file:\n",
        "\n",
        "        file.write(report)\n",
        "\n",
        "    print(\"\\nReport generated successfully.\")\n",
        "    print(f\"Output file: {OUTPUT_FILE}\")\n",
        "\n",
        "except FileNotFoundError:\n",
        "\n",
        "    print(f\"Error: {INPUT_FILE} was not found.\")\n",
        "\n",
        "except Exception as e:\n",
        "\n",
        "    print(f\"Error: {e}\")"
      ]
    }
  ]
