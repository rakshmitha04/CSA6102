        "from datetime import datetime\n",
        "from collections import defaultdict\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CONFIGURATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Events within this many seconds are considered correlated\n",
        "CORRELATION_WINDOW = 60\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SIMULATED FORENSIC RECORDS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "file_activity = [\n",
        "    (\"2026-08-29 09:00:10\", \"File Created\", \"report.docx\"),\n",
        "    (\"2026-08-29 09:15:20\", \"File Modified\", \"evidence.txt\"),\n",
        "    (\"2026-08-29 10:30:05\", \"File Deleted\", \"temp.txt\")\n",
        "]\n",
        "\n",
        "authentication_logs = [\n",
        "    (\"2026-08-29 09:00:00\", \"Login Success\", \"user1\"),\n",
        "    (\"2026-08-29 09:45:00\", \"Login Failure\", \"user2\"),\n",
        "    (\"2026-08-29 10:29:40\", \"Login Success\", \"admin\")\n",
        "]\n",
        "\n",
        "browser_records = [\n",
        "    (\"2026-08-29 09:00:30\", \"Visited URL\", \"https://example.com\"),\n",
        "    (\"2026-08-29 09:15:45\", \"Downloaded File\", \"evidence.txt\"),\n",
        "    (\"2026-08-29 11:00:00\", \"Visited URL\", \"https://test.com\")\n",
        "]\n",
        "\n",
        "network_events = [\n",
        "    (\"2026-08-29 09:00:40\", \"Outbound Connection\", \"10.0.0.20\"),\n",
        "    (\"2026-08-29 09:16:00\", \"Network Transfer\", \"10.0.0.50\"),\n",
        "    (\"2026-08-29 12:00:00\", \"DNS Request\", \"example.com\")\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# TIMESTAMP NORMALIZATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def normalize_timestamp(timestamp):\n",
        "\n",
        "    # Convert all timestamps into the same datetime format\n",
        "    return datetime.strptime(\n",
        "        timestamp,\n",
        "        \"%Y-%m-%d %H:%M:%S\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ADD EVENTS TO MASTER TIMELINE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "timeline = []\n",
        "\n",
        "\n",
        "def add_events(records, source):\n",
        "\n",
        "    for record in records:\n",
        "\n",
        "        timestamp, activity, detail = record\n",
        "\n",
        "        normalized_time = normalize_timestamp(timestamp)\n",
        "\n",
        "        timeline.append({\n",
        "            \"timestamp\": normalized_time,\n",
        "            \"source\": source,\n",
        "            \"activity\": activity,\n",
        "            \"detail\": detail\n",
        "        })\n",
        "\n",
        "\n",
        "# Add all evidence sources\n",
        "add_events(file_activity, \"FILE\")\n",
        "add_events(authentication_logs, \"AUTHENTICATION\")\n",
        "add_events(browser_records, \"BROWSER\")\n",
        "add_events(network_events, \"NETWORK\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SORT CHRONOLOGICALLY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "timeline.sort(\n",
        "    key=lambda event: event[\"timestamp\"]\n",
        ")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY MASTER TIMELINE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 85)\n",
        "print(\"FORENSIC TIMELINE CORRELATION\")\n",
        "print(\"=\" * 85)\n",
        "\n",
        "print(\"\\nMASTER CHRONOLOGICAL TIMELINE\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "for number, event in enumerate(timeline, 1):\n",
        "\n",
        "    print(\n",
        "        f\"{number:02d}. \"\n",
        "        f\"{event['timestamp']} | \"\n",
        "        f\"{event['source']:<14} | \"\n",
        "        f\"{event['activity']:<22} | \"\n",
        "        f\"{event['detail']}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FIND CORRELATED EVENTS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 85)\n",
        "print(\"CORRELATED ACTIVITY\")\n",
        "print(\"=\" * 85)\n",
        "\n",
        "correlated_groups = []\n",
        "\n",
        "for i in range(len(timeline)):\n",
        "\n",
        "    base_event = timeline[i]\n",
        "\n",
        "    group = [base_event]\n",
        "\n",
        "    sources = {\n",
        "        base_event[\"source\"]\n",
        "    }\n",
        "\n",
        "    for j in range(i + 1, len(timeline)):\n",
        "\n",
        "        next_event = timeline[j]\n",
        "\n",
        "        time_difference = (\n",
        "            next_event[\"timestamp\"]\n",
        "            - base_event[\"timestamp\"]\n",
        "        ).total_seconds()\n",
        "\n",
        "        if time_difference <= CORRELATION_WINDOW:\n",
        "\n",
        "            group.append(next_event)\n",
        "            sources.add(next_event[\"source\"])\n",
        "\n",
        "        else:\n",
        "            break\n",
        "\n",
        "    # Only report groups involving different evidence sources\n",
        "    if len(sources) >= 2:\n",
        "\n",
        "        correlated_groups.append(group)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# REMOVE DUPLICATE CORRELATION GROUPS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "unique_groups = []\n",
        "\n",
        "seen = set()\n",
        "\n",
        "for group in correlated_groups:\n",
        "\n",
        "    key = tuple(\n",
        "        (\n",
        "            event[\"timestamp\"],\n",
        "            event[\"source\"],\n",
        "            event[\"activity\"],\n",
        "            event[\"detail\"]\n",
        "        )\n",
        "        for event in group\n",
        "    )\n",
        "\n",
        "    if key not in seen:\n",
        "\n",
        "        seen.add(key)\n",
        "        unique_groups.append(group)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY CORRELATED PERIODS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "if unique_groups:\n",
        "\n",
        "    for number, group in enumerate(unique_groups, 1):\n",
        "\n",
        "        print(\n",
        "            f\"\\nCorrelation Period {number}\"\n",
        "        )\n",
        "\n",
        "        print(\"-\" * 70)\n",
        "\n",
        "        start = group[0][\"timestamp\"]\n",
        "        end = group[-1][\"timestamp\"]\n",
        "\n",
        "        print(f\"Start : {start}\")\n",
        "        print(f\"End   : {end}\")\n",
        "\n",
        "        print(\"\\nRelated Events:\")\n",
        "\n",
        "        for event in group:\n",
        "\n",
        "            print(\n",
        "                f\"  {event['timestamp']} | \"\n",
        "                f\"{event['source']} | \"\n",
        "                f\"{event['activity']} | \"\n",
        "                f\"{event['detail']}\"\n",
        "            )\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\n",
        "        \"\\nNo cross-source activity occurred \"\n",
        "        f\"within {CORRELATION_WINDOW} seconds.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 85)\n",
        "print(\"CORRELATION SUMMARY\")\n",
        "print(\"=\" * 85)\n",
        "\n",
        "print(\n",
        "    f\"Total events analyzed : {len(timeline)}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Correlation window    : \"\n",
        "    f\"{CORRELATION_WINDOW} seconds\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Correlated periods    : \"\n",
        "    f\"{len(unique_groups)}\"\n",
        ")\n",
        "\n",
        "print(\"\\nEvidence sources:\")\n",
        "print(\"  - File activity\")\n",
        "print(\"  - Authentication logs\")\n",
        "print(\"  - Browser records\")\n",
        "print(\"  - Network events\")\n",
        "\n",
        "print(\"\\nTimeline correlation completed.\")"
      ]
    }
