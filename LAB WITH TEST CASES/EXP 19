        "!pip install whoisdomain # Install the missing library\n",
        "import whoisdomain\n",
        "from collections import defaultdict\n",
        "from datetime import datetime\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# READ DOMAINS FROM FILE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def read_domains(filename):\n",
        "\n",
        "    domains = []\n",
        "\n",
        "    with open(filename, \"r\") as file:\n",
        "\n",
        "        for line in file:\n",
        "\n",
        "            domain = line.strip().lower()\n",
        "\n",
        "            if domain and not domain.startswith(\"#\"):\n",
        "                domains.append(domain)\n",
        "\n",
        "    return domains\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FORMAT VALUES\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def format_value(value):\n",
        "\n",
        "    if value is None:\n",
        "        return \"Unavailable\"\n",
        "\n",
        "    if isinstance(value, list):\n",
        "\n",
        "        if not value:\n",
        "            return \"Unavailable\"\n",
        "\n",
        "        return \", \".join(str(x) for x in value)\n",
        "\n",
        "    return str(value)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# GET REGISTRATION INFORMATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def collect_information(domains):\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for domain in domains:\n",
        "\n",
        "        print(f\"Collecting information for: {domain}\")\n",
        "\n",
        "        try:\n",
        "\n",
        "            data = whoisdomain.query(domain)\n",
        "\n",
        "            if data is None:\n",
        "\n",
        "                results.append({\n",
        "                    \"domain\": domain,\n",
        "                    \"registrar\": \"Unavailable\",\n",
        "                    \"registration_date\": \"Unavailable\",\n",
        "                    \"expiration_date\": \"Unavailable\",\n",
        "                    \"name_servers\": []\n",
        "                })\n",
        "\n",
        "                continue\n",
        "\n",
        "            # The package exposes parsed WHOIS/RDAP information.\n",
        "            # getattr() keeps the program tolerant of missing fields.\n",
        "\n",
        "            registrar = getattr(\n",
        "                data,\n",
        "                \"registrar\",\n",
        "                None\n",
        "            )\n",
        "\n",
        "            creation_date = getattr(\n",
        "                data,\n",
        "                \"creation_date\",\n",
        "                None\n",
        "            )\n",
        "\n",
        "            expiration_date = getattr(\n",
        "                data,\n",
        "                \"expiration_date\",\n",
        "                None\n",
        "            )\n",
        "\n",
        "            name_servers = getattr(\n",
        "                data,\n",
        "                \"name_servers\",\n",
        "                []\n",
        "            )\n",
        "\n",
        "            results.append({\n",
        "                \"domain\": domain,\n",
        "                \"registrar\": format_value(registrar),\n",
        "                \"registration_date\": format_value(\n",
        "                    creation_date\n",
        "                ),\n",
        "                \"expiration_date\": format_value(\n",
        "                    expiration_date\n",
        "                ),\n",
        "                \"name_servers\": name_servers or []\n",
        "            })\n",
        "\n",
        "        except Exception as error:\n",
        "\n",
        "            print(\n",
        "                f\"  Lookup failed: {error}\"\n",
        "            )\n",
        "\n",
        "            results.append({\n",
        "                \"domain\": domain,\n",
        "                \"registrar\": \"Lookup failed\",\n",
        "                \"registration_date\": \"Unavailable\",\n",
        "                \"expiration_date\": \"Unavailable\",\n",
        "                \"name_servers\": []\n",
        "            })\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY INDIVIDUAL RESULTS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_results(results):\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 80)\n",
        "    print(\"DOMAIN REGISTRATION INFORMATION\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    for record in results:\n",
        "\n",
        "        print(\"\\n\" + \"-\" * 80)\n",
        "\n",
        "        print(\n",
        "            f\"Domain            : \"\n",
        "            f\"{record['domain']}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Registrar         : \"\n",
        "            f\"{record['registrar']}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Registration Date : \"\n",
        "            f\"{record['registration_date']}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Expiration Date   : \"\n",
        "            f\"{record['expiration_date']}\"\n",
        "        )\n",
        "\n",
        "        print(\"Name Servers      :\")\n",
        "\n",
        "        if record[\"name_servers\"]:\n",
        "\n",
        "            for server in record[\"name_servers\"]:\n",
        "                print(f\"  - {server}\")\n",
        "\n",
        "        else:\n",
        "\n",
        "            print(\"  - Unavailable\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FIND COMMON REGISTRATION CHARACTERISTICS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def find_common_characteristics(results):\n",
        "\n",
        "    registrar_groups = defaultdict(list)\n",
        "    registration_groups = defaultdict(list)\n",
        "    expiration_groups = defaultdict(list)\n",
        "    nameserver_groups = defaultdict(list)\n",
        "\n",
        "    for record in results:\n",
        "\n",
        "        # Registrar grouping\n",
        "        registrar = record[\"registrar\"]\n",
        "\n",
        "        if registrar not in [\n",
        "            \"Unavailable\",\n",
        "            \"Lookup failed\"\n",
        "        ]:\n",
        "\n",
        "            registrar_groups[registrar].append(\n",
        "                record[\"domain\"]\n",
        "            )\n",
        "\n",
        "        # Registration date grouping\n",
        "        registration_date = record[\n",
        "            \"registration_date\"\n",
        "        ]\n",
        "\n",
        "        if registration_date != \"Unavailable\":\n",
        "\n",
        "            registration_groups[\n",
        "                registration_date\n",
        "            ].append(record[\"domain\"])\n",
        "\n",
        "        # Expiration date grouping\n",
        "        expiration_date = record[\n",
        "            \"expiration_date\"\n",
        "        ]\n",
        "\n",
        "        if expiration_date != \"Unavailable\":\n",
        "\n",
        "            expiration_groups[\n",
        "                expiration_date\n",
        "            ].append(record[\"domain\"])\n",
        "\n",
        "        # Name-server grouping\n",
        "        for server in record[\"name_servers\"]:\n",
        "\n",
        "            nameserver_groups[\n",
        "                str(server).lower()\n",
        "            ].append(record[\"domain\"])\n",
        "\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 80)\n",
        "    print(\"COMMON REGISTRATION CHARACTERISTICS\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # COMMON REGISTRARS\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\nCommon Registrars\")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "    found = False\n",
        "\n",
        "    for registrar, domains in registrar_groups.items():\n",
        "\n",
        "        if len(domains) > 1:\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{registrar}: \"\n",
        "                f\"{', '.join(domains)}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No common registrar groups found.\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # COMMON REGISTRATION DATES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\nCommon Registration Dates\")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "    found = False\n",
        "\n",
        "    for date, domains in registration_groups.items():\n",
        "\n",
        "        if len(domains) > 1:\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{date}: \"\n",
        "                f\"{', '.join(domains)}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No common registration dates found.\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # COMMON EXPIRATION DATES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\nCommon Expiration Dates\")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "    found = False\n",
        "\n",
        "    for date, domains in expiration_groups.items():\n",
        "\n",
        "        if len(domains) > 1:\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{date}: \"\n",
        "                f\"{', '.join(domains)}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No common expiration dates found.\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # COMMON NAME SERVERS\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\nCommon Name Servers\")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "    found = False\n",
        "\n",
        "    for server, domains in nameserver_groups.items():\n",
        "\n",
        "        if len(domains) > 1:\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{server}: \"\n",
        "                f\"{', '.join(domains)}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No common name-server groups found.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# INVESTIGATION SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def investigation_summary(results):\n",
        "\n",
        "    successful = 0\n",
        "    failed = 0\n",
        "\n",
        "    registrars = set()\n",
        "\n",
        "    for record in results:\n",
        "\n",
        "        if record[\"registrar\"] not in [\n",
        "            \"Unavailable\",\n",
        "            \"Lookup failed\"\n",
        "        ]:\n",
        "\n",
        "            successful += 1\n",
        "            registrars.add(record[\"registrar\"])\n",
        "\n",
        "        else:\n",
        "\n",
        "            failed += 1\n",
        "\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 80)\n",
        "    print(\"OSINT INVESTIGATION SUMMARY\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    print(\n",
        "        f\"Domains analyzed       : \"\n",
        "        f\"{len(results)}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Successful lookups     : \"\n",
        "        f\"{successful}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Failed/limited lookups : \"\n",
        "        f\"{failed}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Unique registrars      : \"\n",
        "        f\"{len(registrars)}\"\n",
        "    )\n",
        "\n",
        "    print(\"\\nDomains analyzed:\")\n",
        "\n",
        "    for record in results:\n",
        "\n",
        "        print(\n",
        "            f\"  {record['domain']}\"\n",
        "        )\n",
        "\n",
        "    print(\"\\nInvestigation completed.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "INPUT_FILE = \"domains.txt\"\n",
        "\n",
        "try:\n",
        "\n",
        "    domains = read_domains(INPUT_FILE)\n",
        "\n",
        "    if not domains:\n",
        "\n",
        "        print(\"No domains found in domains.txt\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        results = collect_information(domains)\n",
        "\n",
        "        display_results(results)\n",
        "\n",
        "        find_common_characteristics(results)\n",
        "\n",
        "        investigation_summary(results)\n",
        "\n",
        "except FileNotFoundError:\n",
        "\n",
        "    print(\n",
        "        \"Error: domains.txt was not found.\"\n",
        "    )\n",
        "\n",
        "except Exception as error:\n",
        "\n",
        "    print(\n",
        "        f\"Program error: {error}\"\n",
        "    )"
      ]
    }
