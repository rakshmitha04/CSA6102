        "     b\"%PDF-1.7\\nThis is actually a PDF\"),\n",
        "\n",
        "    # Correct JPEG\n",
        "    (\"evidence.jpg\",\n",
        "     b\"\\xFF\\xD8\\xFF\\xE0\\x00\\x10JFIF\"),\n",
        "\n",
        "    # Misleading document extension\n",
        "    (\"report.docx\",\n",
        "     b\"\\xFF\\xD8\\xFF\\xE0\\x00\\x10JFIF\"),\n",
        "\n",
        "    # Correct ZIP archive\n",
        "    (\"backup.zip\",\n",
        "     b\"PK\\x03\\x04\\x14\\x00Archive data\"),\n",
        "\n",
        "    # Misleading archive\n",
        "    (\"photos.zip\",\n",
        "     b\"\\x89PNG\\r\\n\\x1a\\nPNG image data\"),\n",
        "\n",
        "    # Correct executable\n",
        "    (\"program.exe\",\n",
        "     b\"MZ\\x90\\x00\\x03\\x00\\x00\\x00Windows executable\"),\n",
        "\n",
        "    # Misleading executable\n",
        "    (\"invoice.pdf\",\n",
        "     b\"MZ\\x90\\x00\\x03\\x00\\x00\\x00Windows executable\"),\n",
        "\n",
        "    # Text file\n",
        "    (\"notes.txt\",\n",
        "     b\"This is a forensic investigation note.\")\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# RUN ANALYSIS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"FILE SIGNATURE FORENSIC UTILITY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "for filename, content in test_files:\n",
        "    analyze_file(filename, content)"
