        "import os\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FILE SIGNATURE DATABASE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "SIGNATURES = {\n",
        "    \".pdf\": [b\"%PDF\"],\n",
        "    \".jpg\": [b\"\\xFF\\xD8\\xFF\"],\n",
        "    \".png\": [b\"\\x89PNG\\r\\n\\x1a\\n\"],\n",
        "    \".zip\": [b\"PK\\x03\\x04\"],\n",
        "    \".exe\": [b\"MZ\"],\n",
        "    \".docx\": [b\"PK\\x03\\x04\"],\n",
        "    \".xlsx\": [b\"PK\\x03\\x04\"],\n",
        "}\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CONTENT CHARACTERISTICS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def identify_content(data):\n",
        "    \"\"\"Identify the actual file type using signatures/content.\"\"\"\n",
        "\n",
        "    if data.startswith(b\"%PDF\"):\n",
        "        return \".pdf\", \"PDF document signature\"\n",
        "\n",
        "    if data.startswith(b\"\\xFF\\xD8\\xFF\"):\n",
        "        return \".jpg\", \"JPEG image signature\"\n",
        "\n",
        "    if data.startswith(b\"\\x89PNG\\r\\n\\x1a\\n\"):\n",
        "        return \".png\", \"PNG image signature\"\n",
        "\n",
        "    if data.startswith(b\"PK\\x03\\x04\"):\n",
        "        # ZIP-based Office files have PK signature.\n",
        "        # Check internal text for Office characteristics.\n",
        "        if b\"word/\" in data or b\"[Content_Types].xml\" in data:\n",
        "            return \".docx\", \"ZIP-based Microsoft Word structure\"\n",
        "\n",
        "        if b\"xl/\" in data:\n",
        "            return \".xlsx\", \"ZIP-based Microsoft Excel structure\"\n",
        "\n",
        "        return \".zip\", \"ZIP archive signature\"\n",
        "\n",
        "    if data.startswith(b\"MZ\"):\n",
        "        return \".exe\", \"Windows PE executable signature\"\n",
        "\n",
        "    # Simple text detection\n",
        "    try:\n",
        "        data.decode(\"utf-8\")\n",
        "        return \".txt\", \"Readable text content\"\n",
        "    except UnicodeDecodeError:\n",
        "        return \".unknown\", \"Unknown binary content\"\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FORENSIC ANALYSIS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def analyze_file(filename, data):\n",
        "\n",
        "    extension = os.path.splitext(filename)[1].lower()\n",
        "\n",
        "    actual_type, characteristic = identify_content(data)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"FORENSIC FILE TYPE ANALYSIS\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    print(f\"Filename             : {filename}\")\n",
        "    print(f\"Claimed Extension    : {extension}\")\n",
        "    print(f\"Detected File Type   : {actual_type}\")\n",
        "    print(f\"Content Characteristic: {characteristic}\")\n",
        "\n",
        "    # Display file signature evidence\n",
        "    signature = data[:16]\n",
        "\n",
        "    print(f\"First 16 Bytes       : {signature}\")\n",
        "\n",
        "    # Classification\n",
        "    if extension == actual_type:\n",
        "\n",
        "        print(\"\\nClassification       : CONSISTENT\")\n",
        "        print(\"Warning              : None\")\n",
        "        print(\"Evidence             : Filename extension matches file signature.\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"\\nClassification       : INCONSISTENT\")\n",
        "\n",
        "        print(\"Warning              : WARNING - POSSIBLE FILE TYPE MISREPRESENTATION\")\n",
        "\n",
        "        print(\"Evidence             :\")\n",
        "        print(f\"  - Filename claims  : {extension}\")\n",
        "        print(f\"  - Signature shows  : {actual_type}\")\n",
        "        print(f\"  - Content indicates: {characteristic}\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SIMULATED FORENSIC FILES\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "test_files = [\n",
        "\n",
        "    # Correct PDF\n",
        "    (\"case_report.pdf\",\n",
        "     b\"%PDF-1.7\\nThis is a PDF document\"),\n",
        "\n",
        "    # Misleading image extension\n",
