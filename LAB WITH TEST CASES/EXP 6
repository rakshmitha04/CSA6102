        "from PIL import Image\n",
        "from PIL.ExifTags import TAGS, GPSTAGS\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# EXTRACT EXIF METADATA\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def extract_metadata(filename):\n",
        "    metadata = {\n",
        "        \"Camera Make\": None,\n",
        "        \"Camera Model\": None,\n",
        "        \"Date/Time\": None,\n",
        "        \"Dimensions\": None,\n",
        "        \"Orientation\": None,\n",
        "        \"GPS Latitude\": None,\n",
        "        \"GPS Longitude\": None,\n",
        "        \"GPS Altitude\": None\n",
        "    }\n",
        "\n",
        "    try:\n",
        "        image = Image.open(filename)\n",
        "\n",
        "        # Image dimensions\n",
        "        metadata[\"Dimensions\"] = f\"{image.width} x {image.height}\"\n",
        "\n",
        "        exif = image.getexif()\n",
        "\n",
        "        if not exif:\n",
        "            return metadata\n",
        "\n",
        "        # Convert EXIF tag numbers to names\n",
        "        exif_data = {}\n",
        "\n",
        "        for tag_id, value in exif.items():\n",
        "            tag_name = TAGS.get(tag_id, tag_id)\n",
        "            exif_data[tag_name] = value\n",
        "\n",
        "        # Camera information\n",
        "        metadata[\"Camera Make\"] = exif_data.get(\"Make\")\n",
        "        metadata[\"Camera Model\"] = exif_data.get(\"Model\")\n",
        "\n",
        "        # Timestamp\n",
        "        metadata[\"Date/Time\"] = (\n",
        "            exif_data.get(\"DateTimeOriginal\")\n",
        "            or exif_data.get(\"DateTime\")\n",
        "        )\n",
        "\n",
        "        # Orientation\n",
        "        metadata[\"Orientation\"] = exif_data.get(\"Orientation\")\n",
        "\n",
        "        # GPS information\n",
        "        gps_info = exif_data.get(\"GPSInfo\")\n",
        "\n",
        "        if gps_info:\n",
        "            gps_data = {}\n",
        "\n",
        "            for key, value in gps_info.items():\n",
        "                gps_tag = GPSTAGS.get(key, key)\n",
        "                gps_data[gps_tag] = value\n",
        "\n",
        "            metadata[\"GPS Latitude\"] = gps_data.get(\"GPSLatitude\")\n",
        "            metadata[\"GPS Longitude\"] = gps_data.get(\"GPSLongitude\")\n",
        "            metadata[\"GPS Altitude\"] = gps_data.get(\"GPSAltitude\")\n",
        "\n",
        "        return metadata\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error reading {filename}: {e}\")\n",
        "        return metadata\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# COMPARE TWO METADATA RECORDS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def compare_metadata(meta1, meta2):\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"IMAGE FORENSIC METADATA COMPARISON\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    identical = []\n",
        "    different = []\n",
        "    unavailable = []\n",
        "\n",
        "    for field in meta1:\n",
        "\n",
        "        value1 = meta1[field]\n",
        "        value2 = meta2[field]\n",
        "\n",
        "        print(f\"\\nField: {field}\")\n",
        "        print(f\"Image 1: {value1 if value1 is not None else 'Unavailable'}\")\n",
        "        print(f\"Image 2: {value2 if value2 is not None else 'Unavailable'}\")\n",
        "\n",
        "        # Both unavailable\n",
        "        if value1 is None and value2 is None:\n",
        "            status = \"UNAVAILABLE\"\n",
        "            unavailable.append(field)\n",
        "\n",
        "        # One unavailable\n",
        "        elif value1 is None or value2 is None:\n",
        "            status = \"UNAVAILABLE\"\n",
        "            unavailable.append(field)\n",
        "\n",
        "        # Same values\n",
        "        elif value1 == value2:\n",
        "            status = \"IDENTICAL\"\n",
        "            identical.append(field)\n",
        "\n",
        "        # Different values\n",
        "        else:\n",
        "            status = \"DIFFERENT\"\n",
        "            different.append(field)\n",
        "\n",
        "        print(f\"Status : {status}\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # SUMMARY\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"COMPARISON SUMMARY\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    print(f\"\\nIdentical fields   : {len(identical)}\")\n",
        "    for field in identical:\n",
        "        print(f\"  ✓ {field}\")\n",
        "\n",
        "    print(f\"\\nDifferent fields   : {len(different)}\")\n",
        "    for field in different:\n",
        "        print(f\"  ! {field}\")\n",
        "\n",
        "    print(f\"\\nUnavailable fields : {len(unavailable)}\")\n",
        "    for field in unavailable:\n",
        "        print(f\"  - {field}\")\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "\n",
        "    if different:\n",
        "        print(\"FORENSIC RESULT: Metadata differences detected.\")\n",
        "\n",
        "    elif identical:\n",
        "        print(\"FORENSIC RESULT: Available metadata is consistent.\")\n",
        "\n",
        "    else:\n",
        "        print(\"FORENSIC RESULT: Insufficient metadata for comparison.\")\n",
        "\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"IMAGE FORENSICS UTILITY\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "image1 = input(\"Enter first image path: \")\n",
        "image2 = input(\"Enter second image path: \")\n",
        "\n",
        "print(\"\\nExtracting metadata...\")\n",
        "\n",
        "metadata1 = extract_metadata(image1)\n",
        "metadata2 = extract_metadata(image2)\n",
        "\n",
        "compare_metadata(metadata1, metadata2)"
