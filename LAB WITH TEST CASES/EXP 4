        "from collections import defaultdict\n",
        "\n",
        "# Simulated firewall log\n",
        "# Format:\n",
        "# (Timestamp, Source IP, Destination Port, Action)\n",
        "\n",
        "firewall_logs = [\n",
        "    (\"2026-08-29 09:10:12\", \"192.168.1.10\", 22, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:11:15\", \"192.168.1.10\", 22, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:12:20\", \"192.168.1.10\", 22, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:13:25\", \"192.168.1.10\", 22, \"BLOCKED\"),\n",
        "\n",
        "    (\"2026-08-29 09:20:10\", \"192.168.1.20\", 3389, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:21:15\", \"192.168.1.20\", 3389, \"BLOCKED\"),\n",
        "\n",
        "    (\"2026-08-29 09:30:10\", \"10.0.0.5\", 23, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:31:12\", \"10.0.0.5\", 23, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:32:14\", \"10.0.0.5\", 23, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:33:16\", \"10.0.0.5\", 23, \"BLOCKED\"),\n",
        "    (\"2026-08-29 09:34:18\", \"10.0.0.5\", 23, \"BLOCKED\"),\n",
        "\n",
        "    (\"2026-08-29 09:40:10\", \"192.168.1.30\", 80, \"ALLOWED\"),\n",
        "    (\"2026-08-29 09:41:10\", \"192.168.1.40\", 443, \"ALLOWED\")\n",
        "]\n",
        "\n",
        "# Threshold for persistent activity\n",
        "PERSISTENT_THRESHOLD = 3\n",
        "\n",
        "\n",
        "def investigate_firewall_logs(logs):\n",
        "\n",
        "    # Dictionary to group blocked records\n",
        "    grouped_records = defaultdict(list)\n",
        "\n",
        "    # Process only BLOCKED records\n",
        "    for timestamp, source_ip, destination_port, action in logs:\n",
        "\n",
        "        if action.upper() == \"BLOCKED\":\n",
        "            key = (source_ip, destination_port)\n",
        "            grouped_records[key].append(timestamp)\n",
        "\n",
        "    print(\"\\nFIREWALL LOG INVESTIGATION\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    findings = []\n",
        "\n",
        "    # Analyze each source IP + port combination\n",
        "    for (source_ip, port), timestamps in grouped_records.items():\n",
        "\n",
        "        frequency = len(timestamps)\n",
        "\n",
        "        if frequency >= PERSISTENT_THRESHOLD:\n",
        "            status = \"PERSISTENT ACTIVITY\"\n",
        "        else:\n",
        "            status = \"NORMAL / LOW FREQUENCY\"\n",
        "\n",
        "        findings.append(\n",
        "            (frequency, source_ip, port, status, timestamps)\n",
        "        )\n",
        "\n",
        "    # Display highest frequency first\n",
        "    findings.sort(reverse=True)\n",
        "\n",
        "    print(\"\\nMOST SIGNIFICANT FINDINGS\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    for frequency, source_ip, port, status, timestamps in findings:\n",
        "\n",
        "        print(f\"\\nSource Address   : {source_ip}\")\n",
        "        print(f\"Destination Port : {port}\")\n",
        "        print(f\"Attempt Frequency : {frequency}\")\n",
        "        print(f\"Classification    : {status}\")\n",
        "\n",
        "        print(\"Timestamps:\")\n",
        "        for timestamp in timestamps:\n",
        "            print(f\"  - {timestamp}\")\n",
        "\n",
        "\n",
        "# Run investigation\n",
        "investigate_firewall_logs(firewall_logs)"
      ]
