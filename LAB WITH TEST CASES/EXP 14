        "import hashlib\n",
        "import json\n",
        "import os\n",
        "from datetime import datetime\n",
        "\n",
        "DATABASE_FILE = \"forensic_hash_database.json\"\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CALCULATE SHA-256\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def calculate_sha256(file_path):\n",
        "\n",
        "    sha256 = hashlib.sha256()\n",
        "\n",
        "    try:\n",
        "        with open(file_path, \"rb\") as file:\n",
        "\n",
        "            while True:\n",
        "                data = file.read(4096)\n",
        "\n",
        "                if not data:\n",
        "                    break\n",
        "\n",
        "                sha256.update(data)\n",
        "\n",
        "        return sha256.hexdigest()\n",
        "\n",
        "    except FileNotFoundError:\n",
        "        return None\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# LOAD DATABASE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def load_database():\n",
        "\n",
        "    if not os.path.exists(DATABASE_FILE):\n",
        "        return []\n",
        "\n",
        "    try:\n",
        "        with open(DATABASE_FILE, \"r\") as file:\n",
        "            return json.load(file)\n",
        "\n",
        "    except json.JSONDecodeError:\n",
        "        return []\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SAVE DATABASE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def save_database(database):\n",
        "\n",
        "    with open(DATABASE_FILE, \"w\") as file:\n",
        "        json.dump(database, file, indent=4)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ADD NEW EVIDENCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def add_evidence():\n",
        "\n",
        "    print(\"\\n--- ADD NEW FORENSIC EVIDENCE ---\")\n",
        "\n",
        "    file_path = input(\"Enter file path: \")\n",
        "    evidence_id = input(\"Enter Evidence ID: \")\n",
        "    description = input(\"Enter evidence description: \")\n",
        "    investigator = input(\"Enter investigator name: \")\n",
        "\n",
        "    sha256 = calculate_sha256(file_path)\n",
        "\n",
        "    if sha256 is None:\n",
        "        print(\"ERROR: File not found.\")\n",
        "        return\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    # Create evidence record\n",
        "    record = {\n",
        "        \"evidence_id\": evidence_id,\n",
        "        \"file_name\": os.path.basename(file_path),\n",
        "        \"file_path\": file_path,\n",
        "        \"description\": description,\n",
        "        \"investigator\": investigator,\n",
        "        \"date_time\": datetime.now().strftime(\n",
        "            \"%Y-%m-%d %H:%M:%S\"\n",
        "        ),\n",
        "        \"sha256\": sha256\n",
        "    }\n",
        "\n",
        "    database.append(record)\n",
        "\n",
        "    save_database(database)\n",
        "\n",
        "    print(\"\\nEvidence stored successfully.\")\n",
        "    print(\"Evidence ID :\", evidence_id)\n",
        "    print(\"File Name   :\", os.path.basename(file_path))\n",
        "    print(\"SHA-256     :\", sha256)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SEARCH FOR MATCHING HASH\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def search_evidence():\n",
        "\n",
        "    print(\"\\n--- SEARCH FORENSIC HASH DATABASE ---\")\n",
        "\n",
        "    file_path = input(\"Enter file path to examine: \")\n",
        "\n",
        "    sha256 = calculate_sha256(file_path)\n",
        "\n",
        "    if sha256 is None:\n",
        "        print(\"ERROR: File not found.\")\n",
        "        return\n",
        "\n",
        "    print(\"\\nCalculated SHA-256:\")\n",
        "    print(sha256)\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    matches = []\n",
        "\n",
        "    for record in database:\n",
        "\n",
        "        if record[\"sha256\"] == sha256:\n",
        "            matches.append(record)\n",
        "\n",
        "    # Display results\n",
        "    if matches:\n",
        "\n",
        "        print(\"\\nMATCHING EVIDENCE RECORD FOUND\")\n",
        "        print(\"=\" * 60)\n",
        "\n",
        "        for record in matches:\n",
        "\n",
        "            print(f\"\\nEvidence ID : {record['evidence_id']}\")\n",
        "            print(f\"File Name  : {record['file_name']}\")\n",
        "            print(f\"Description: {record['description']}\")\n",
        "            print(f\"Investigator: {record['investigator']}\")\n",
        "            print(f\"Date/Time  : {record['date_time']}\")\n",
        "            print(f\"SHA-256    : {record['sha256']}\")\n",
        "\n",
        "        print(\"\\nResult: The examined file matches existing evidence.\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"\\nNO MATCHING EVIDENCE RECORD FOUND\")\n",
        "        print(\"Result: This SHA-256 value is not present in the database.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY DATABASE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_database():\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    print(\"\\n--- FORENSIC HASH DATABASE ---\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    if not database:\n",
        "        print(\"Database is empty.\")\n",
        "        return\n",
        "\n",
        "    for record in database:\n",
        "\n",
        "        print(f\"\\nEvidence ID : {record['evidence_id']}\")\n",
        "        print(f\"File Name  : {record['file_name']}\")\n",
        "        print(f\"Description: {record['description']}\")\n",
        "        print(f\"Investigator: {record['investigator']}\")\n",
        "        print(f\"Date/Time  : {record['date_time']}\")\n",
        "        print(f\"SHA-256    : {record['sha256']}\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN MENU\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "while True:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"FORENSIC HASH DATABASE\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    print(\"1. Add new evidence\")\n",
        "    print(\"2. Search evidence\")\n",
        "    print(\"3. Display database\")\n",
        "    print(\"4. Exit\")\n",
        "\n",
        "    choice = input(\"\\nEnter your choice: \")\n",
        "\n",
        "    if choice == \"1\":\n",
        "        add_evidence()\n",
        "\n",
        "    elif choice == \"2\":\n",
        "        search_evidence()\n",
        "\n",
        "    elif choice == \"3\":\n",
        "        display_database()\n",
        "\n",
        "    elif choice == \"4\":\n",
        "        print(\"Exiting program.\")\n",
        "        break\n",
        "\n",
        "    else:\n",
        "        print(\"Invalid choice.\")"
      ],
