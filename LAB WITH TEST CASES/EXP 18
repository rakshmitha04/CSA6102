        "import os\n",
        "import time\n",
        "from datetime import datetime\n",
        "from collections import Counter\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CONFIGURATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "DIRECTORY = input(\"Enter directory to monitor: \")\n",
        "\n",
        "MONITOR_TIME = int(\n",
        "    input(\"Enter monitoring time in seconds: \")\n",
        ")\n",
        "\n",
        "CHECK_INTERVAL = 1\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# GET CURRENT FILE STATE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def get_file_state(directory):\n",
        "\n",
        "    file_state = {}\n",
        "\n",
        "    for root, dirs, files in os.walk(directory):\n",
        "\n",
        "        for file in files:\n",
        "\n",
        "            path = os.path.join(root, file)\n",
        "\n",
        "            try:\n",
        "                file_state[path] = os.path.getmtime(path)\n",
        "\n",
        "            except OSError:\n",
        "                pass\n",
        "\n",
        "    return file_state\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# INITIAL STATE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "if not os.path.isdir(DIRECTORY):\n",
        "\n",
        "    print(\"Error: Directory does not exist.\")\n",
        "    exit()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"FILE-SYSTEM ACTIVITY DIARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(f\"Monitoring directory : {DIRECTORY}\")\n",
        "print(f\"Monitoring duration  : {MONITOR_TIME} seconds\")\n",
        "\n",
        "previous_state = get_file_state(DIRECTORY)\n",
        "\n",
        "event_number = 0\n",
        "events = []\n",
        "\n",
        "creation_count = 0\n",
        "modification_count = 0\n",
        "deletion_count = 0\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MONITOR DIRECTORY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "print(\"\\nMonitoring started...\\n\")\n",
        "\n",
        "while time.time() - start_time < MONITOR_TIME:\n",
        "\n",
        "    time.sleep(CHECK_INTERVAL)\n",
        "\n",
        "    current_state = get_file_state(DIRECTORY)\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # CHECK FOR CREATED FILES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    for path in current_state:\n",
        "\n",
        "        if path not in previous_state:\n",
        "\n",
        "            event_number += 1\n",
        "            creation_count += 1\n",
        "\n",
        "            event = (\n",
        "                event_number,\n",
        "                datetime.now().strftime(\n",
        "                    \"%Y-%m-%d %H:%M:%S\"\n",
        "                ),\n",
        "                \"CREATED\",\n",
        "                path\n",
        "            )\n",
        "\n",
        "            events.append(event)\n",
        "\n",
        "            print(\n",
        "                f\"[{event_number}] \"\n",
        "                f\"CREATED : {path}\"\n",
        "            )\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # CHECK FOR MODIFIED FILES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    for path in current_state:\n",
        "\n",
        "        if path in previous_state:\n",
        "\n",
        "            if current_state[path] != previous_state[path]:\n",
        "\n",
        "                event_number += 1\n",
        "                modification_count += 1\n",
        "\n",
        "                event = (\n",
        "                    event_number,\n",
        "                    datetime.now().strftime(\n",
        "                        \"%Y-%m-%d %H:%M:%S\"\n",
        "                    ),\n",
        "                    \"MODIFIED\",\n",
        "                    path\n",
        "                )\n",
        "\n",
        "                events.append(event)\n",
        "\n",
        "                print(\n",
        "                    f\"[{event_number}] \"\n",
        "                    f\"MODIFIED: {path}\"\n",
        "                )\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # CHECK FOR DELETED FILES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    for path in previous_state:\n",
        "\n",
        "        if path not in current_state:\n",
        "\n",
        "            event_number += 1\n",
        "            deletion_count += 1\n",
        "\n",
        "            event = (\n",
        "                event_number,\n",
        "                datetime.now().strftime(\n",
        "                    \"%Y-%m-%d %H:%M:%S\"\n",
        "                ),\n",
        "                \"DELETED\",\n",
        "                path\n",
        "            )\n",
        "\n",
        "            events.append(event)\n",
        "\n",
        "            print(\n",
        "                f\"[{event_number}] \"\n",
        "                f\"DELETED : {path}\"\n",
        "            )\n",
        "\n",
        "    previous_state = current_state\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CREATE ACTIVITY DIARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "with open(\n",
        "    \"filesystem_activity_diary.txt\",\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as file:\n",
        "\n",
        "    file.write(\"FILE-SYSTEM ACTIVITY DIARY\\n\")\n",
        "    file.write(\"=\" * 70 + \"\\n\\n\")\n",
        "\n",
        "    file.write(\n",
        "        f\"Directory: {DIRECTORY}\\n\"\n",
        "    )\n",
        "\n",
        "    file.write(\n",
        "        f\"Monitoring Time: {MONITOR_TIME} seconds\\n\\n\"\n",
        "    )\n",
        "\n",
        "    file.write(\"DETECTED EVENTS\\n\")\n",
        "    file.write(\"-\" * 70 + \"\\n\")\n",
        "\n",
        "    for event in events:\n",
        "\n",
        "        number, timestamp, event_type, path = event\n",
        "\n",
        "        file.write(\n",
        "            f\"Event {number} | \"\n",
        "            f\"{timestamp} | \"\n",
        "            f\"{event_type} | \"\n",
        "            f\"{path}\\n\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FIND MOST FREQUENTLY AFFECTED FILES\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "file_frequency = Counter()\n",
        "\n",
        "for event in events:\n",
        "\n",
        "    path = event[3]\n",
        "\n",
        "    file_frequency[path] += 1\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FINAL SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"FILE-SYSTEM ACTIVITY SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    f\"Creation events     : {creation_count}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Modification events : {modification_count}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Deletion events     : {deletion_count}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Total events        : {len(events)}\"\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nMOST FREQUENTLY AFFECTED FILES\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "if file_frequency:\n",
        "\n",
        "    for path, count in file_frequency.most_common():\n",
        "\n",
        "        print(\n",
        "            f\"{count} event(s) : {path}\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\"No file-system changes detected.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ADD SUMMARY TO DIARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "with open(\n",
        "    \"filesystem_activity_diary.txt\",\n",
        "    \"a\",\n",
        "    encoding=\"utf-8\"\n",
        ") as file:\n",
        "\n",
        "    file.write(\"\\n\\nSUMMARY\\n\")\n",
        "    file.write(\"=\" * 70 + \"\\n\")\n",
        "\n",
        "    file.write(\n",
        "        f\"Creation events     : {creation_count}\\n\"\n",
        "    )\n",
        "\n",
        "    file.write(\n",
        "        f\"Modification events : {modification_count}\\n\"\n",
        "    )\n",
        "\n",
        "    file.write(\n",
        "        f\"Deletion events     : {deletion_count}\\n\"\n",
        "    )\n",
        "\n",
        "    file.write(\n",
        "        f\"Total events        : {len(events)}\\n\"\n",
        "    )\n",
        "\n",
        "    file.write(\n",
        "        \"\\nMOST FREQUENTLY AFFECTED FILES\\n\"\n",
        "    )\n",
        "\n",
        "    for path, count in file_frequency.most_common():\n",
        "\n",
        "        file.write(\n",
        "            f\"{count} event(s) : {path}\\n\"\n",
        "        )\n",
        "\n",
        "print(\"\\nActivity diary saved as:\")\n",
        "print(\"filesystem_activity_diary.txt\")"
      ]
    }
  ]
