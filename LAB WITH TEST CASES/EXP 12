        "from collections import defaultdict\n",
        "from datetime import datetime\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SIMULATED PACKET RECORDS\n",
        "# Format:\n",
        "# (Timestamp, Source IP, Destination IP, Packet Size)\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "packets = [\n",
        "    (\"2026-08-29 10:00:05\", \"192.168.1.10\", \"10.0.0.10\", 500),\n",
        "    (\"2026-08-29 10:00:20\", \"192.168.1.11\", \"10.0.0.10\", 600),\n",
        "    (\"2026-08-29 10:00:45\", \"192.168.1.12\", \"10.0.0.10\", 450),\n",
        "\n",
        "    (\"2026-08-29 10:01:10\", \"192.168.1.13\", \"10.0.0.10\", 500),\n",
        "    (\"2026-08-29 10:01:30\", \"192.168.1.14\", \"10.0.0.10\", 550),\n",
        "\n",
        "    # Traffic spike toward 10.0.0.10\n",
        "    (\"2026-08-29 10:02:05\", \"192.168.1.15\", \"10.0.0.10\", 700),\n",
        "    (\"2026-08-29 10:02:10\", \"192.168.1.16\", \"10.0.0.10\", 650),\n",
        "    (\"2026-08-29 10:02:15\", \"192.168.1.17\", \"10.0.0.10\", 600),\n",
        "    (\"2026-08-29 10:02:20\", \"192.168.1.18\", \"10.0.0.10\", 550),\n",
        "    (\"2026-08-29 10:02:25\", \"192.168.1.19\", \"10.0.0.10\", 500),\n",
        "    (\"2026-08-29 10:02:30\", \"192.168.1.20\", \"10.0.0.10\", 450),\n",
        "    (\"2026-08-29 10:02:35\", \"192.168.1.21\", \"10.0.0.10\", 500),\n",
        "\n",
        "    (\"2026-08-29 10:03:05\", \"192.168.1.22\", \"10.0.0.20\", 400),\n",
        "    (\"2026-08-29 10:03:20\", \"192.168.1.23\", \"10.0.0.20\", 450),\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CONFIGURATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "WINDOW_SECONDS = 60\n",
        "\n",
        "# A window is considered a spike when its count is at\n",
        "# least this many times the previous window.\n",
        "SPIKE_MULTIPLIER = 2\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CONVERT TIMESTAMP\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def parse_time(timestamp):\n",
        "    return datetime.strptime(\n",
        "        timestamp,\n",
        "        \"%Y-%m-%d %H:%M:%S\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CREATE TIME WINDOWS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def create_windows(records):\n",
        "\n",
        "    if not records:\n",
        "        return {}\n",
        "\n",
        "    # Sort packets by timestamp\n",
        "    records = sorted(\n",
        "        records,\n",
        "        key=lambda x: parse_time(x[0])\n",
        "    )\n",
        "\n",
        "    start_time = parse_time(records[0][0])\n",
        "\n",
        "    windows = defaultdict(list)\n",
        "\n",
        "    for record in records:\n",
        "\n",
        "        timestamp, source, destination, size = record\n",
        "\n",
        "        current_time = parse_time(timestamp)\n",
        "\n",
        "        elapsed = (current_time - start_time).total_seconds()\n",
        "\n",
        "        window_number = int(elapsed // WINDOW_SECONDS)\n",
        "\n",
        "        windows[window_number].append(record)\n",
        "\n",
        "    return windows\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CALCULATE DESTINATION STATISTICS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def calculate_statistics(windows):\n",
        "\n",
        "    statistics = {}\n",
        "\n",
        "    for window_number, records in windows.items():\n",
        "\n",
        "        destination_counts = defaultdict(int)\n",
        "        total_bytes = defaultdict(int)\n",
        "\n",
        "        for record in records:\n",
        "\n",
        "            timestamp, source, destination, size = record\n",
        "\n",
        "            destination_counts[destination] += 1\n",
        "            total_bytes[destination] += size\n",
        "\n",
        "        statistics[window_number] = {\n",
        "            \"packet_count\": len(records),\n",
        "            \"destination_counts\": dict(destination_counts),\n",
        "            \"total_bytes\": dict(total_bytes)\n",
        "        }\n",
        "\n",
        "    return statistics\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY WINDOW STATISTICS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_statistics(statistics):\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"PACKET TRAFFIC BY TIME WINDOW\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    for window in sorted(statistics):\n",
        "\n",
        "        stats = statistics[window]\n",
        "\n",
        "        print(f\"\\nTime Window {window + 1}\")\n",
        "        print(\"-\" * 50)\n",
        "\n",
        "        print(\n",
        "            f\"Total Packets : {stats['packet_count']}\"\n",
        "        )\n",
        "\n",
        "        for destination, count in stats[\n",
        "            \"destination_counts\"\n",
        "        ].items():\n",
        "\n",
        "            bytes_sent = stats[\"total_bytes\"][destination]\n",
        "\n",
        "            print(\n",
        "                f\"Destination   : {destination}\"\n",
        "            )\n",
        "            print(\n",
        "                f\"Packets       : {count}\"\n",
        "            )\n",
        "            print(\n",
        "                f\"Traffic       : {bytes_sent} bytes\"\n",
        "            )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DETECT TRAFFIC SPIKES\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def detect_spikes(statistics):\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"SIGNIFICANT TRAFFIC SPIKES\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    found = False\n",
        "\n",
        "    sorted_windows = sorted(statistics)\n",
        "\n",
        "    for i in range(1, len(sorted_windows)):\n",
        "\n",
        "        previous_window = sorted_windows[i - 1]\n",
        "        current_window = sorted_windows[i]\n",
        "\n",
        "        previous_stats = statistics[previous_window]\n",
        "        current_stats = statistics[current_window]\n",
        "\n",
        "        destinations = set(\n",
        "            previous_stats[\"destination_counts\"]\n",
        "        ) | set(\n",
        "            current_stats[\"destination_counts\"]\n",
        "        )\n",
        "\n",
        "        for destination in destinations:\n",
        "\n",
        "            previous_count = previous_stats[\n",
        "                \"destination_counts\"\n",
        "            ].get(destination, 0)\n",
        "\n",
        "            current_count = current_stats[\n",
        "                \"destination_counts\"\n",
        "            ].get(destination, 0)\n",
        "\n",
        "            # Avoid division by zero\n",
        "            if previous_count == 0:\n",
        "                if current_count >= 3:\n",
        "                    spike = True\n",
        "                else:\n",
        "                    spike = False\n",
        "            else:\n",
        "                spike = (\n",
        "                    current_count >=\n",
        "                    previous_count * SPIKE_MULTIPLIER\n",
        "                )\n",
        "\n",
        "            if spike:\n",
        "\n",
        "                found = True\n",
        "\n",
        "                print(\n",
        "                    f\"\\nDestination : {destination}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"Previous Window : \"\n",
        "                    f\"{previous_window + 1}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"Previous Packets: \"\n",
        "                    f\"{previous_count}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"Current Window  : \"\n",
        "                    f\"{current_window + 1}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"Current Packets : \"\n",
        "                    f\"{current_count}\"\n",
        "                )\n",
        "\n",
        "                if previous_count > 0:\n",
        "\n",
        "                    increase = (\n",
        "                        (current_count - previous_count)\n",
        "                        / previous_count\n",
        "                    ) * 100\n",
        "\n",
        "                    print(\n",
        "                        f\"Increase        : \"\n",
        "                        f\"{increase:.2f}%\"\n",
        "                    )\n",
        "\n",
        "                print(\"Status          : TRAFFIC SPIKE\")\n",
        "\n",
        "    if not found:\n",
        "        print(\"\\nNo significant traffic spikes detected.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"NETWORK PACKET SPIKE ANALYZER\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    f\"Time Window Size : {WINDOW_SECONDS} seconds\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Spike Threshold  : \"\n",
        "    f\"{SPIKE_MULTIPLIER}x previous window\"\n",
        ")\n",
        "\n",
        "# Create windows\n",
        "windows = create_windows(packets)\n",
        "\n",
        "# Calculate statistics\n",
        "statistics = calculate_statistics(windows)\n",
        "\n",
        "# Display statistics\n",
        "display_statistics(statistics)\n",
        "\n",
        "# Detect spikes\n",
        "detect_spikes(statistics)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"ANALYSIS COMPLETED\")\n",
        "print(\"=\" * 75)"
      ]
    }
