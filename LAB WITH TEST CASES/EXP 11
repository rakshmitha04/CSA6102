        "# ---------------------------------------------------------\n",
        "# PROCESS HIERARCHY FORENSIC ANALYZER\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Simulated process execution log\n",
        "# Format:\n",
        "# (PID, Parent PID, Process Name, User)\n",
        "\n",
        "process_log = [\n",
        "    (100, 0, \"System\", \"SYSTEM\"),\n",
        "    (200, 100, \"explorer.exe\", \"User\"),\n",
        "    (300, 200, \"chrome.exe\", \"User\"),\n",
        "    (301, 200, \"notepad.exe\", \"User\"),\n",
        "    (400, 200, \"winword.exe\", \"User\"),\n",
        "    (401, 400, \"spoolsv.exe\", \"User\"),\n",
        "\n",
        "    # Suspicious relationship\n",
        "    (500, 300, \"cmd.exe\", \"User\"),\n",
        "\n",
        "    # Suspicious relationship\n",
        "    (501, 300, \"powershell.exe\", \"User\"),\n",
        "\n",
        "    # Suspicious relationship\n",
        "    (600, 301, \"svchost.exe\", \"User\")\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# EXPECTED PARENT-CHILD RELATIONSHIPS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "expected_parents = {\n",
        "    \"explorer.exe\": [\"System\"],\n",
        "    \"chrome.exe\": [\"explorer.exe\"],\n",
        "    \"notepad.exe\": [\"explorer.exe\"],\n",
        "    \"winword.exe\": [\"explorer.exe\"],\n",
        "    \"cmd.exe\": [\"explorer.exe\"],\n",
        "    \"powershell.exe\": [\"explorer.exe\"],\n",
        "    \"spoolsv.exe\": [\"System\"],\n",
        "    \"svchost.exe\": [\"System\"]\n",
        "}\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CREATE PROCESS DICTIONARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "processes = {}\n",
        "\n",
        "for pid, ppid, name, user in process_log:\n",
        "\n",
        "    processes[pid] = {\n",
        "        \"pid\": pid,\n",
        "        \"ppid\": ppid,\n",
        "        \"name\": name,\n",
        "        \"user\": user\n",
        "    }\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# BUILD PARENT-CHILD RELATIONSHIPS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "children = {}\n",
        "\n",
        "for pid, process in processes.items():\n",
        "\n",
        "    ppid = process[\"ppid\"]\n",
        "\n",
        "    if ppid not in children:\n",
        "        children[ppid] = []\n",
        "\n",
        "    children[ppid].append(pid)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY PROCESS TREE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_tree(pid, level=0):\n",
        "\n",
        "    if pid not in processes:\n",
        "        return\n",
        "\n",
        "    process = processes[pid]\n",
        "\n",
        "    print(\n",
        "        \"  \" * level +\n",
        "        f\"└── {process['name']} \"\n",
        "        f\"(PID={process['pid']}, \"\n",
        "        f\"PPID={process['ppid']})\"\n",
        "    )\n",
        "\n",
        "    for child_pid in children.get(pid, []):\n",
        "        display_tree(child_pid, level + 1)\n",
        "\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"PROCESS HIERARCHY ANALYSIS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"\\nProcess Tree:\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "# Start from root processes\n",
        "for pid, process in processes.items():\n",
        "\n",
        "    if process[\"ppid\"] == 0:\n",
        "        display_tree(pid)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# IDENTIFY SUSPICIOUS RELATIONSHIPS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\nSUSPICIOUS PROCESS RELATIONSHIPS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "suspicious_count = 0\n",
        "\n",
        "for pid, process in processes.items():\n",
        "\n",
        "    name = process[\"name\"]\n",
        "    ppid = process[\"ppid\"]\n",
        "\n",
        "    # Ignore root process\n",
        "    if ppid == 0:\n",
        "        continue\n",
        "\n",
        "    # Find parent process\n",
        "    parent = processes.get(ppid)\n",
        "\n",
        "    if parent is None:\n",
        "\n",
        "        print(f\"\\nSuspicious Process: {name}\")\n",
        "        print(f\"PID              : {pid}\")\n",
        "        print(f\"Parent PID       : {ppid}\")\n",
        "        print(\"Parent Process   : NOT FOUND\")\n",
        "        print(\"Reason           : Parent process does not exist.\")\n",
        "\n",
        "        suspicious_count += 1\n",
        "        continue\n",
        "\n",
        "    parent_name = parent[\"name\"]\n",
        "\n",
        "    # Check predefined expected relationship\n",
        "    allowed_parents = expected_parents.get(name, [])\n",
        "\n",
        "    if parent_name not in allowed_parents:\n",
        "\n",
        "        suspicious_count += 1\n",
        "\n",
        "        print(f\"\\nSuspicious Process : {name}\")\n",
        "        print(f\"PID                : {pid}\")\n",
        "        print(f\"Parent Process     : {parent_name}\")\n",
        "        print(f\"Parent PID         : {ppid}\")\n",
        "        print(f\"User               : {process['user']}\")\n",
        "\n",
        "        print(\n",
        "            f\"Expected Parent   : \"\n",
        "            f\"{', '.join(allowed_parents) if allowed_parents else 'Unknown'}\"\n",
        "        )\n",
        "\n",
        "        print(\"Reason             : Parent-child relationship violates \"\n",
        "              \"the predefined expected pattern.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"FORENSIC ANALYSIS SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(f\"Total processes analyzed : {len(processes)}\")\n",
        "print(f\"Suspicious relationships : {suspicious_count}\")\n",
        "\n",
        "if suspicious_count == 0:\n",
        "    print(\"Result: No abnormal process relationships detected.\")\n",
        "else:\n",
        "    print(\"Result: Suspicious parent-child relationships detected.\")"
      ]
