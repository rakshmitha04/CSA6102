        "from collections import defaultdict\n",
        "from datetime import datetime\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SIMULATED USB CONNECTION RECORDS\n",
        "# Format:\n",
        "# (Timestamp, Device ID, Device Name, User, Status)\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "usb_records = [\n",
        "    (\"2026-08-25 09:10:00\", \"USB001\", \"Kingston_32GB\",\n",
        "     \"Alice\", \"NEW\"),\n",
        "\n",
        "    (\"2026-08-25 14:30:00\", \"USB002\", \"SanDisk_64GB\",\n",
        "     \"Bob\", \"NEW\"),\n",
        "\n",
        "    (\"2026-08-26 10:15:00\", \"USB001\", \"Kingston_32GB\",\n",
        "     \"Alice\", \"RECOGNIZED\"),\n",
        "\n",
        "    (\"2026-08-26 16:45:00\", \"USB003\", \"Transcend_16GB\",\n",
        "     \"Charlie\", \"NEW\"),\n",
        "\n",
        "    (\"2026-08-27 09:20:00\", \"USB001\", \"Kingston_32GB\",\n",
        "     \"Alice\", \"RECOGNIZED\"),\n",
        "\n",
        "    (\"2026-08-27 13:10:00\", \"USB002\", \"SanDisk_64GB\",\n",
        "     \"Bob\", \"RECOGNIZED\"),\n",
        "\n",
        "    (\"2026-08-28 11:30:00\", \"USB003\", \"Transcend_16GB\",\n",
        "     \"Charlie\", \"RECOGNIZED\"),\n",
        "\n",
        "    (\"2026-08-29 08:45:00\", \"USB001\", \"Kingston_32GB\",\n",
        "     \"Alice\", \"RECOGNIZED\")\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CONVERT TIMESTAMP\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def parse_time(timestamp):\n",
        "    return datetime.strptime(\n",
        "        timestamp,\n",
        "        \"%Y-%m-%d %H:%M:%S\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ANALYZE USB RECORDS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def analyze_usb_records(records):\n",
        "\n",
        "    devices = defaultdict(list)\n",
        "\n",
        "    # Store records by device ID\n",
        "    for record in records:\n",
        "\n",
        "        timestamp, device_id, device_name, user, status = record\n",
        "\n",
        "        devices[device_id].append(record)\n",
        "\n",
        "    # Sort each device history chronologically\n",
        "    for device_id in devices:\n",
        "\n",
        "        devices[device_id].sort(\n",
        "            key=lambda x: parse_time(x[0])\n",
        "        )\n",
        "\n",
        "    return devices\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY DEVICE SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_device_summary(devices):\n",
        "\n",
        "    print(\"=\" * 75)\n",
        "    print(\"REMOVABLE MEDIA FORENSIC ANALYSIS\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    for device_id, records in devices.items():\n",
        "\n",
        "        first_record = records[0]\n",
        "\n",
        "        first_time = first_record[0]\n",
        "        device_name = first_record[2]\n",
        "\n",
        "        # Find users associated with device\n",
        "        users = sorted(\n",
        "            set(record[3] for record in records)\n",
        "        )\n",
        "\n",
        "        # Check whether device was previously recognized\n",
        "        previously_recognized = any(\n",
        "            record[4] == \"RECOGNIZED\"\n",
        "            for record in records\n",
        "        )\n",
        "\n",
        "        print(\"\\n\" + \"-\" * 75)\n",
        "\n",
        "        print(f\"Device ID              : {device_id}\")\n",
        "        print(f\"Device Name            : {device_name}\")\n",
        "        print(f\"First Connected        : {first_time}\")\n",
        "        print(f\"Connection Frequency   : {len(records)} time(s)\")\n",
        "        print(f\"Associated User(s)     : {', '.join(users)}\")\n",
        "\n",
        "        if previously_recognized:\n",
        "            print(\"Previously Recognized  : YES\")\n",
        "        else:\n",
        "            print(\"Previously Recognized  : NO\")\n",
        "\n",
        "        print(\"-\" * 75)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CHRONOLOGICAL HISTORY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_chronological_history(records):\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 75)\n",
        "    print(\"CHRONOLOGICAL DEVICE-USAGE HISTORY\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    # Sort all records by timestamp\n",
        "    sorted_records = sorted(\n",
        "        records,\n",
        "        key=lambda x: parse_time(x[0])\n",
        "    )\n",
        "\n",
        "    for number, record in enumerate(sorted_records, 1):\n",
        "\n",
        "        timestamp, device_id, device_name, user, status = record\n",
        "\n",
        "        print(\n",
        "            f\"{number}. {timestamp} | \"\n",
        "            f\"Device: {device_id} | \"\n",
        "            f\"Name: {device_name} | \"\n",
        "            f\"User: {user} | \"\n",
        "            f\"Status: {status}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DETECT NEW DEVICES\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_new_devices(records):\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 75)\n",
        "    print(\"NEW DEVICE DETECTION\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    seen_devices = set()\n",
        "\n",
        "    for record in sorted(\n",
        "        records,\n",
        "        key=lambda x: parse_time(x[0])\n",
        "    ):\n",
        "\n",
        "        timestamp, device_id, device_name, user, status = record\n",
        "\n",
        "        if device_id not in seen_devices:\n",
        "\n",
        "            seen_devices.add(device_id)\n",
        "\n",
        "            if status == \"NEW\":\n",
        "\n",
        "                print(\n",
        "                    f\"New Device: {device_id} | \"\n",
        "                    f\"{device_name} | \"\n",
        "                    f\"First Connected: {timestamp} | \"\n",
        "                    f\"User: {user}\"\n",
        "                )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"USB REMOVABLE-MEDIA INVESTIGATION TOOL\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "devices = analyze_usb_records(usb_records)\n",
        "\n",
        "display_device_summary(devices)\n",
        "\n",
        "display_chronological_history(usb_records)\n",
        "\n",
        "display_new_devices(usb_records)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"INVESTIGATION COMPLETED\")\n",
        "print(\"=\" * 75)"
      ]
    }
