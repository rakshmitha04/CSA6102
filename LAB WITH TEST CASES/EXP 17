      "source": [
        "import json\n",
        "import os\n",
        "\n",
        "DATABASE_FILE = \"evidence_inventory.json\"\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# LOAD EVIDENCE DATABASE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def load_database():\n",
        "    if os.path.exists(DATABASE_FILE):\n",
        "        with open(DATABASE_FILE, \"r\") as file:\n",
        "            return json.load(file)\n",
        "\n",
        "    return []\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SAVE EVIDENCE DATABASE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def save_database(database):\n",
        "    with open(DATABASE_FILE, \"w\") as file:\n",
        "        json.dump(database, file, indent=4)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ADD EVIDENCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def add_evidence():\n",
        "\n",
        "    print(\"\\n--- ADD EVIDENCE ---\")\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    evidence = {\n",
        "        \"evidence_number\": input(\"Evidence Number: \"),\n",
        "        \"description\": input(\"Description: \"),\n",
        "        \"type\": input(\"Evidence Type: \"),\n",
        "        \"source\": input(\"Source: \"),\n",
        "        \"acquisition_method\": input(\"Acquisition Method: \"),\n",
        "        \"storage_location\": input(\"Storage Location: \"),\n",
        "        \"file_size\": input(\"File Size: \"),\n",
        "        \"hash_value\": input(\"SHA-256 Hash Value: \"),\n",
        "        \"status\": input(\n",
        "            \"Integrity Status (Verified/Changed/Unknown): \"\n",
        "        )\n",
        "    }\n",
        "\n",
        "    database.append(evidence)\n",
        "\n",
        "    save_database(database)\n",
        "\n",
        "    print(\"\\nEvidence added successfully.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY ALL EVIDENCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def display_evidence():\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"DIGITAL FORENSIC EVIDENCE INVENTORY\")\n",
        "    print(\"=\" * 75)\n",
        "\n",
        "    if not database:\n",
        "        print(\"No evidence records found.\")\n",
        "        return\n",
        "\n",
        "    for evidence in database:\n",
        "\n",
        "        print(\"\\n\" + \"-\" * 75)\n",
        "\n",
        "        for key, value in evidence.items():\n",
        "\n",
        "            print(\n",
        "                f\"{key.replace('_', ' ').title():22}: {value}\"\n",
        "            )\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SEARCH BY EVIDENCE TYPE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def search_by_type():\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    search_type = input(\n",
        "        \"\\nEnter evidence type to search: \"\n",
        "    ).lower()\n",
        "\n",
        "    found = False\n",
        "\n",
        "    print(\"\\nSEARCH RESULTS\")\n",
        "    print(\"-\" * 75)\n",
        "\n",
        "    for evidence in database:\n",
        "\n",
        "        if evidence[\"type\"].lower() == search_type:\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{evidence['evidence_number']} | \"\n",
        "                f\"{evidence['description']} | \"\n",
        "                f\"Type: {evidence['type']}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No matching evidence found.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SEARCH BY SOURCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def search_by_source():\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    source = input(\n",
        "        \"\\nEnter source to search: \"\n",
        "    ).lower()\n",
        "\n",
        "    found = False\n",
        "\n",
        "    print(\"\\nSEARCH RESULTS\")\n",
        "    print(\"-\" * 75)\n",
        "\n",
        "    for evidence in database:\n",
        "\n",
        "        if source in evidence[\"source\"].lower():\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{evidence['evidence_number']} | \"\n",
        "                f\"{evidence['description']} | \"\n",
        "                f\"Source: {evidence['source']}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No matching evidence found.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FILTER BY INTEGRITY STATUS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def filter_by_integrity():\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    status = input(\n",
        "        \"\\nEnter integrity status \"\n",
        "        \"(Verified/Changed/Unknown): \"\n",
        "    ).lower()\n",
        "\n",
        "    found = False\n",
        "\n",
        "    print(\"\\nINTEGRITY FILTER RESULTS\")\n",
        "    print(\"-\" * 75)\n",
        "\n",
        "    for evidence in database:\n",
        "\n",
        "        if evidence[\"status\"].lower() == status:\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"{evidence['evidence_number']} | \"\n",
        "                f\"{evidence['description']} | \"\n",
        "                f\"Status: {evidence['status']} | \"\n",
        "                f\"Hash: {evidence['hash_value']}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No matching evidence found.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# GENERAL SEARCH\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def general_search():\n",
        "\n",
        "    database = load_database()\n",
        "\n",
        "    keyword = input(\n",
        "        \"\\nEnter keyword to search: \"\n",
        "    ).lower()\n",
        "\n",
        "    found = False\n",
        "\n",
        "    print(\"\\nSEARCH RESULTS\")\n",
        "    print(\"-\" * 75)\n",
        "\n",
        "    for evidence in database:\n",
        "\n",
        "        # Search across all fields\n",
        "        if any(\n",
        "            keyword in str(value).lower()\n",
        "            for value in evidence.values()\n",
        "        ):\n",
        "\n",
        "            found = True\n",
        "\n",
        "            print(\n",
        "                f\"\\nEvidence Number : \"\n",
        "                f\"{evidence['evidence_number']}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"Description     : \"\n",
        "                f\"{evidence['description']}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"Type            : \"\n",
        "                f\"{evidence['type']}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"Source          : \"\n",
        "                f\"{evidence['source']}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"Integrity       : \"\n",
        "                f\"{evidence['status']}\"\n",
        "            )\n",
        "\n",
        "    if not found:\n",
        "        print(\"No matching evidence found.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN MENU\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "while True:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"DIGITAL FORENSIC EVIDENCE INVENTORY\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    print(\"1. Add Evidence\")\n",
        "    print(\"2. Display All Evidence\")\n",
        "    print(\"3. Search by Type\")\n",
        "    print(\"4. Search by Source\")\n",
        "    print(\"5. Filter by Integrity Status\")\n",
        "    print(\"6. General Search\")\n",
        "    print(\"7. Exit\")\n",
        "\n",
        "    choice = input(\"\\nEnter your choice: \")\n",
        "\n",
        "    if choice == \"1\":\n",
        "        add_evidence()\n",
        "\n",
        "    elif choice == \"2\":\n",
        "        display_evidence()\n",
        "\n",
        "    elif choice == \"3\":\n",
        "        search_by_type()\n",
        "\n",
        "    elif choice == \"4\":\n",
        "        search_by_source()\n",
        "\n",
        "    elif choice == \"5\":\n",
        "        filter_by_integrity()\n",
        "\n",
        "    elif choice == \"6\":\n",
        "        general_search()\n",
        "\n",
        "    elif choice == \"7\":\n",
        "        print(\"\\nExiting application.\")\n",
        "        break\n",
        "\n",
        "    else:\n",
        "        print(\"\\nInvalid choice.\")"
      ]
    }
  ]
