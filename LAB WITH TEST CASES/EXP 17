            "\n",
            "============================================================\n",
            "DIGITAL FORENSIC EVIDENCE INVENTORY\n",
            "============================================================\n",
            "1. Add Evidence\n",
            "2. Display All Evidence\n",
            "3. Search by Type\n",
            "4. Search by Source\n",
            "5. Filter by Integrity Status\n",
            "6. General Search\n",
            "7. Exit\n",
            "\n",
            "Enter your choice: 7\n",
            "\n",
            "Exiting application.\n"
          ]
        }
