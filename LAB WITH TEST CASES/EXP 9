        "from datetime import datetime\n",
        "from urllib.parse import urlparse\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SIMULATED EMAIL MAILBOX\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "emails = [\n",
        "    {\n",
        "        \"id\": \"E001\",\n",
        "        \"sender\": \"security@company.com\",\n",
        "        \"recipient\": \"employee@company.com\",\n",
        "        \"timestamp\": \"2026-08-29 09:15:00\",\n",
        "        \"subject\": \"Security Policy Update\",\n",
        "        \"attachments\": [],\n",
        "        \"urls\": [\"https://company.com/security\"]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"id\": \"E002\",\n",
        "        \"sender\": \"admin@paypa1-security.com\",\n",
        "        \"recipient\": \"employee@company.com\",\n",
        "        \"timestamp\": \"2026-08-29 02:30:00\",\n",
        "        \"subject\": \"Urgent: Verify Your Account\",\n",
        "        \"attachments\": [\"account_verification.exe\"],\n",
        "        \"urls\": [\"http://paypa1-security.com/login\"]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"id\": \"E003\",\n",
        "        \"sender\": \"unknown123@gmail.com\",\n",
        "        \"recipient\": \"finance@company.com\",\n",
        "        \"timestamp\": \"2026-08-29 10:20:00\",\n",
        "        \"subject\": \"Invoice Payment Required\",\n",
        "        \"attachments\": [\"invoice.zip\"],\n",
        "        \"urls\": [\"http://unknown-site.com/payment\"]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"id\": \"E004\",\n",
        "        \"sender\": \"hr@company.com\",\n",
        "        \"recipient\": \"employee@company.com\",\n",
        "        \"timestamp\": \"2026-08-29 11:00:00\",\n",
        "        \"subject\": \"Annual Leave Policy\",\n",
        "        \"attachments\": [\"leave_policy.pdf\"],\n",
        "        \"urls\": []\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"id\": \"E005\",\n",
        "        \"sender\": \"support@company-support.net\",\n",
        "        \"recipient\": \"admin@company.com\",\n",
        "        \"timestamp\": \"2026-08-29 03:15:00\",\n",
        "        \"subject\": \"Password Reset Required\",\n",
        "        \"attachments\": [\"reset.html\"],\n",
        "        \"urls\": [\"http://company-support.net/reset\"]\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# INVESTIGATION CRITERIA\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "SUSPICIOUS_EXTENSIONS = [\n",
        "    \".exe\",\n",
        "    \".scr\",\n",
        "    \".bat\",\n",
        "    \".cmd\",\n",
        "    \".js\",\n",
        "    \".vbs\",\n",
        "    \".html\",\n",
        "    \".zip\"\n",
        "]\n",
        "\n",
        "TRUSTED_DOMAIN = \"company.com\"\n",
        "\n",
        "SUSPICIOUS_KEYWORDS = [\n",
        "    \"urgent\",\n",
        "    \"verify\",\n",
        "    \"password\",\n",
        "    \"reset\",\n",
        "    \"payment\",\n",
        "    \"account\"\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ANALYZE EMAIL\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def analyze_email(email):\n",
        "\n",
        "    score = 0\n",
        "    reasons = []\n",
        "\n",
        "    sender = email[\"sender\"]\n",
        "    sender_domain = sender.split(\"@\")[-1].lower()\n",
        "\n",
        "    # 1. Sender domain\n",
        "    if sender_domain != TRUSTED_DOMAIN:\n",
        "        score += 3\n",
        "        reasons.append(\"Untrusted sender domain\")\n",
        "\n",
        "    # 2. Recipient information\n",
        "    recipient_domain = email[\"recipient\"].split(\"@\")[-1].lower()\n",
        "\n",
        "    if recipient_domain != TRUSTED_DOMAIN:\n",
        "        score += 1\n",
        "        reasons.append(\"External recipient domain\")\n",
        "\n",
        "    # 3. Timestamp\n",
        "    time = datetime.strptime(\n",
        "        email[\"timestamp\"],\n",
        "        \"%Y-%m-%d %H:%M:%S\"\n",
        "    )\n",
        "\n",
        "    if time.hour < 6 or time.hour >= 23:\n",
        "        score += 2\n",
        "        reasons.append(\"Unusual email timestamp\")\n",
        "\n",
        "    # 4. Subject keywords\n",
        "    subject = email[\"subject\"].lower()\n",
        "\n",
        "    for keyword in SUSPICIOUS_KEYWORDS:\n",
        "        if keyword in subject:\n",
        "            score += 2\n",
        "            reasons.append(\n",
        "                f\"Suspicious subject keyword: {keyword}\"\n",
        "            )\n",
        "            break\n",
        "\n",
        "    # 5. Attachment names\n",
        "    for attachment in email[\"attachments\"]:\n",
        "\n",
        "        attachment_lower = attachment.lower()\n",
        "\n",
        "        for extension in SUSPICIOUS_EXTENSIONS:\n",
        "\n",
        "            if attachment_lower.endswith(extension):\n",
        "                score += 3\n",
        "                reasons.append(\n",
        "                    f\"Suspicious attachment: {attachment}\"\n",
        "                )\n",
        "                break\n",
        "\n",
        "    # 6. Embedded URLs\n",
        "    for url in email[\"urls\"]:\n",
        "\n",
        "        parsed = urlparse(url)\n",
        "\n",
        "        if parsed.scheme != \"https\":\n",
        "            score += 2\n",
        "            reasons.append(\n",
        "                f\"Non-HTTPS URL: {url}\"\n",
        "            )\n",
        "\n",
        "        url_domain = parsed.netloc.lower()\n",
        "\n",
        "        if url_domain and url_domain != TRUSTED_DOMAIN:\n",
        "            score += 2\n",
        "            reasons.append(\n",
        "                f\"External URL domain: {url_domain}\"\n",
        "            )\n",
        "\n",
        "    # Determine risk level\n",
        "    if score >= 8:\n",
        "        risk = \"HIGH\"\n",
        "\n",
        "    elif score >= 4:\n",
        "        risk = \"MEDIUM\"\n",
        "\n",
        "    else:\n",
        "        risk = \"LOW\"\n",
        "\n",
        "    return score, risk, reasons\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# ANALYZE MAILBOX\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "results = []\n",
        "\n",
        "for email in emails:\n",
        "\n",
        "    score, risk, reasons = analyze_email(email)\n",
        "\n",
        "    results.append({\n",
        "        \"email\": email,\n",
        "        \"score\": score,\n",
        "        \"risk\": risk,\n",
        "        \"reasons\": reasons\n",
        "    })\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# RANK EMAILS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "results.sort(\n",
        "    key=lambda x: x[\"score\"],\n",
        "    reverse=True\n",
        ")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY RESULTS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EMAIL FORENSIC ANALYZER\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"\\nRANKED EMAIL FINDINGS\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "for result in results:\n",
        "\n",
        "    email = result[\"email\"]\n",
        "\n",
        "    print(f\"\\nEmail ID       : {email['id']}\")\n",
        "    print(f\"Sender         : {email['sender']}\")\n",
        "    print(f\"Recipient      : {email['recipient']}\")\n",
        "    print(f\"Timestamp      : {email['timestamp']}\")\n",
        "    print(f\"Subject        : {email['subject']}\")\n",
        "    print(f\"Attachments    : {email['attachments']}\")\n",
        "    print(f\"URLs           : {email['urls']}\")\n",
        "    print(f\"Risk Score     : {result['score']}\")\n",
        "    print(f\"Risk Level     : {result['risk']}\")\n",
        "\n",
        "    if result[\"reasons\"]:\n",
        "        print(\"Investigation Reasons:\")\n",
        "\n",
        "        for reason in result[\"reasons\"]:\n",
        "            print(f\"  - {reason}\")\n",
        "\n",
        "    else:\n",
        "        print(\"Investigation Reasons: None\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SHORTLIST\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"FORENSIC INVESTIGATION SHORTLIST\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "shortlist = [\n",
        "    result for result in results\n",
        "    if result[\"risk\"] in [\"HIGH\", \"MEDIUM\"]\n",
        "]\n",
        "\n",
        "if shortlist:\n",
        "\n",
        "    for number, result in enumerate(shortlist, 1):\n",
        "\n",
        "        email = result[\"email\"]\n",
        "\n",
        "        print(\n",
        "            f\"{number}. {email['id']} | \"\n",
        "            f\"{email['subject']} | \"\n",
        "            f\"Risk: {result['risk']} | \"\n",
        "            f\"Score: {result['score']}\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "    print(\"No emails require detailed examination.\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(f\"Total emails analyzed : {len(emails)}\")\n",
        "print(f\"Emails shortlisted    : {len(shortlist)}\")\n",
        "\n",
        "high = sum(\n",
        "    1 for result in results\n",
        "    if result[\"risk\"] == \"HIGH\"\n",
        ")\n",
        "\n",
        "medium = sum(\n",
        "    1 for result in results\n",
        "    if result[\"risk\"] == \"MEDIUM\"\n",
        ")\n",
        "\n",
        "low = sum(\n",
        "    1 for result in results\n",
        "    if result[\"risk\"] == \"LOW\"\n",
        ")\n",
        "\n",
        "print(f\"High risk             : {high}\")\n",
        "print(f\"Medium risk           : {medium}\")\n",
        "print(f\"Low risk              : {low}\")"
      ]
