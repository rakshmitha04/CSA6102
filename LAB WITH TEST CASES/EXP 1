        "import hashlib\n",
        "from datetime import datetime\n",
        "\n",
        "\n",
        "class Evidence:\n",
        "    def __init__(self, evidence_id, source, investigator,\n",
        "                 storage_location, file_path):\n",
        "\n",
        "        self.evidence_id = evidence_id\n",
        "        self.source = source\n",
        "        self.acquisition_time = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "        self.investigator = investigator\n",
        "        self.storage_location = storage_location\n",
        "        self.file_path = file_path\n",
        "\n",
        "        # Calculate SHA-256 at the time of acquisition\n",
        "        self.sha256 = self.calculate_hash()\n",
        "\n",
        "        # Store custody history\n",
        "        self.custody_history = []\n",
        "\n",
        "        # Record initial custody\n",
        "        self.custody_history.append({\n",
        "            \"handler\": investigator,\n",
        "            \"date_time\": self.acquisition_time,\n",
        "            \"action\": \"Evidence Collected\",\n",
        "            \"location\": storage_location\n",
        "        })\n",
        "\n",
        "    def calculate_hash(self):\n",
        "        \"\"\"Calculate SHA-256 hash of the evidence file.\"\"\"\n",
        "        sha256_hash = hashlib.sha256()\n",
        "\n",
        "        try:\n",
        "            with open(self.file_path, \"rb\") as file:\n",
        "                for block in iter(lambda: file.read(4096), b\"\"):\n",
        "                    sha256_hash.update(block)\n",
        "\n",
        "            return sha256_hash.hexdigest()\n",
        "\n",
        "        except FileNotFoundError:\n",
        "            return \"FILE NOT FOUND\"\n",
        "\n",
        "    def add_custody_transfer(self, handler, location, action):\n",
        "        \"\"\"Add a new custody transfer.\"\"\"\n",
        "        transfer_time = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "\n",
        "        self.custody_history.append({\n",
        "            \"handler\": handler,\n",
        "            \"date_time\": transfer_time,\n",
        "            \"action\": action,\n",
        "            \"location\": location\n",
        "        })\n",
        "\n",
        "    def verify_integrity(self):\n",
        "        \"\"\"Compare current hash with the original SHA-256 value.\"\"\"\n",
        "        current_hash = self.calculate_hash()\n",
        "\n",
        "        return current_hash == self.sha256, current_hash\n",
        "\n",
        "    def display_history(self):\n",
        "        \"\"\"Display complete chain of custody.\"\"\"\n",
        "        print(\"\\n\" + \"=\" * 65)\n",
        "        print(\"             FORENSIC EVIDENCE RECORD\")\n",
        "        print(\"=\" * 65)\n",
        "\n",
        "        print(f\"Evidence ID       : {self.evidence_id}\")\n",
        "        print(f\"Source            : {self.source}\")\n",
        "        print(f\"Acquisition Time  : {self.acquisition_time}\")\n",
        "        print(f\"Investigator      : {self.investigator}\")\n",
        "        print(f\"Storage Location  : {self.storage_location}\")\n",
        "        print(f\"Original SHA-256  : {self.sha256}\")\n",
        "\n",
        "        print(\"\\n--- CHAIN OF CUSTODY ---\")\n",
        "\n",
        "        for i, record in enumerate(self.custody_history, 1):\n",
        "            print(f\"\\nTransfer {i}\")\n",
        "            print(f\"Handler           : {record['handler']}\")\n",
        "            print(f\"Date & Time       : {record['date_time']}\")\n",
        "            print(f\"Action            : {record['action']}\")\n",
        "            print(f\"Location          : {record['location']}\")\n",
        "\n",
        "        # Verify integrity\n",
        "        integrity, current_hash = self.verify_integrity()\n",
        "\n",
        "        print(\"\\n--- INTEGRITY VERIFICATION ---\")\n",
        "        print(f\"Recorded SHA-256  : {self.sha256}\")\n",
        "        print(f\"Current SHA-256   : {current_hash}\")\n",
        "\n",
        "        if integrity:\n",
        "            print(\"Integrity Status  : INTACT\")\n",
        "            print(\"Result            : Evidence has not been modified.\")\n",
        "        else:\n",
        "            print(\"Integrity Status  : COMPROMISED\")\n",
        "            print(\"Result            : Evidence may have been modified.\")\n",
        "\n",
        "        print(\"=\" * 65)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# MAIN PROGRAM\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"FORENSIC CHAIN OF CUSTODY SYSTEM\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "evidence_id = input(\"Enter Evidence ID: \")\n",
