      "source": [
        "from collections import defaultdict\n",
        "\n",
        "# Sample network connection records\n",
        "# Format: (Source IP, Destination IP, Destination Port)\n",
        "\n",
        "connections = [\n",
        "    (\"192.168.1.10\", \"192.168.1.101\", 80),\n",
        "    (\"192.168.1.10\", \"192.168.1.102\", 80),\n",
        "    (\"192.168.1.10\", \"192.168.1.103\", 80),\n",
        "    (\"192.168.1.10\", \"192.168.1.104\", 80),\n",
        "\n",
        "    (\"192.168.1.20\", \"192.168.1.200\", 21),\n",
        "    (\"192.168.1.20\", \"192.168.1.200\", 22),\n",
        "    (\"192.168.1.20\", \"192.168.1.200\", 23),\n",
        "    (\"192.168.1.20\", \"192.168.1.200\", 25),\n",
        "\n",
        "    (\"192.168.1.30\", \"192.168.1.150\", 80),\n",
        "    (\"192.168.1.40\", \"192.168.1.151\", 443)\n",
        "]\n",
        "\n",
        "# Threshold for detecting scanning\n",
        "THRESHOLD = 3\n",
        "\n",
        "\n",
        "def detect_horizontal_scanning(records):\n",
        "    \"\"\"\n",
        "    Horizontal scan:\n",
        "    One source contacts the same port on many different hosts.\n",
        "    \"\"\"\n",
        "\n",
        "    groups = defaultdict(list)\n",
        "\n",
        "    for src, dst, port in records:\n",
        "        groups[(src, port)].append((src, dst, port))\n",
        "\n",
        "    print(\"\\n--- HORIZONTAL SCANNING ---\")\n",
        "\n",
        "    found = False\n",
        "\n",
        "    for (src, port), records_list in groups.items():\n",
        "\n",
        "        hosts = set(record[1] for record in records_list)\n",
        "\n",
        "        if len(hosts) >= THRESHOLD:\n",
        "            found = True\n",
        "\n",
        "            print(f\"\\nSource: {src}\")\n",
        "            print(f\"Port: {port}\")\n",
        "            print(f\"Hosts contacted: {len(hosts)}\")\n",
        "            print(\"Classification: HORIZONTAL SCAN\")\n",
        "\n",
        "            print(\"Supporting Records:\")\n",
        "            for record in records_list:\n",
        "                print(record)\n",
        "\n",
        "    if not found:\n",
        "        print(\"No horizontal scanning detected.\")\n",
        "\n",
        "\n",
        "def detect_vertical_scanning(records):\n",
        "    \"\"\"\n",
        "    Vertical scan:\n",
        "    One source contacts many different ports on the same host.\n",
        "    \"\"\"\n",
        "\n",
        "    groups = defaultdict(list)\n",
        "\n",
        "    for src, dst, port in records:\n",
        "        groups[(src, dst)].append((src, dst, port))\n",
        "\n",
        "    print(\"\\n--- VERTICAL SCANNING ---\")\n",
        "\n",
        "    found = False\n",
        "\n",
        "    for (src, dst), records_list in groups.items():\n",
        "\n",
        "        ports = set(record[2] for record in records_list)\n",
        "\n",
        "        if len(ports) >= THRESHOLD:\n",
        "            found = True\n",
        "\n",
        "            print(f\"\\nSource: {src}\")\n",
        "            print(f\"Destination Host: {dst}\")\n",
        "            print(f\"Ports contacted: {len(ports)}\")\n",
        "            print(\"Classification: VERTICAL SCAN\")\n",
        "\n",
        "            print(\"Supporting Records:\")\n",
        "            for record in records_list:\n",
        "                print(record)\n",
        "\n",
        "    if not found:\n",
        "        print(\"No vertical scanning detected.\")\n",
        "\n",
        "\n",
        "# Main program\n",
        "print(\"NETWORK SCANNING DETECTION SYSTEM\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "detect_horizontal_scanning(connections)\n",
        "detect_vertical_scanning(connections)"
      ]
