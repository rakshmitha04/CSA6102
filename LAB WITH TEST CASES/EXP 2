            "\n",
            "Source: 192.168.1.20\n",
            "Destination Host: 192.168.1.200\n",
            "Ports contacted: 4\n",
            "Classification: VERTICAL SCAN\n",
            "Supporting Records:\n",
            "('192.168.1.20', '192.168.1.200', 21)\n",
            "('192.168.1.20', '192.168.1.200', 22)\n",
