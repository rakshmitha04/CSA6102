        "# ---------------------------------------------------------\n",
        "# DOMAIN LOOK-ALIKE ANALYZER\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Legitimate organizational domains\n",
        "legitimate_domains = [\n",
        "    \"company.com\",\n",
        "    \"google.com\",\n",
        "    \"microsoft.com\",\n",
        "    \"amazon.com\",\n",
        "    \"paypal.com\"\n",
        "]\n",
        "\n",
        "# Suspicious-looking domains\n",
        "suspicious_domains = [\n",
        "    \"companny.com\",\n",
        "    \"company-security.com\",\n",
        "    \"secure-company.com\",\n",
        "    \"googlee.com\",\n",
        "    \"micros0ft.com\",\n",
        "    \"microsoft-login.com\",\n",
        "    \"amazon-support.com\",\n",
        "    \"paypa1.com\",\n",
        "    \"paypal-verification.com\"\n",
        "]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# EXTRACT DOMAIN NAME\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def get_name(domain):\n",
        "    return domain.lower().split(\".\")[0]\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CHARACTER DIFFERENCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def character_difference(a, b):\n",
        "\n",
        "    # Compare characters at the same positions\n",
        "    difference = abs(len(a) - len(b))\n",
        "\n",
        "    for x, y in zip(a, b):\n",
        "\n",
        "        if x != y:\n",
        "            difference += 1\n",
        "\n",
        "    return difference\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CHECK CHARACTER SUBSTITUTION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def substitution_check(suspicious, legitimate):\n",
        "\n",
        "    substitutions = {\n",
        "        \"0\": \"o\",\n",
        "        \"1\": \"l\",\n",
        "        \"3\": \"e\",\n",
        "        \"4\": \"a\",\n",
        "        \"5\": \"s\",\n",
        "        \"7\": \"t\",\n",
        "        \"@\": \"a\"\n",
        "    }\n",
        "\n",
        "    converted = suspicious\n",
        "\n",
        "    for fake, real in substitutions.items():\n",
        "        converted = converted.replace(fake, real)\n",
        "\n",
        "    if converted == legitimate:\n",
        "        return True\n",
        "\n",
        "    return False\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# CALCULATE LOOK-ALIKE SCORE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def similarity_score(suspicious, legitimate):\n",
        "\n",
        "    score = 0\n",
        "    reasons = []\n",
        "\n",
        "    suspicious_name = get_name(suspicious)\n",
        "    legitimate_name = get_name(legitimate)\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # Character substitution\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    if substitution_check(\n",
        "        suspicious_name,\n",
        "        legitimate_name\n",
        "    ):\n",
        "\n",
        "        score += 5\n",
        "        reasons.append(\"Character substitution\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # Exact name\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    if suspicious_name == legitimate_name:\n",
        "\n",
        "        score += 5\n",
        "        reasons.append(\"Same domain name\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # Additional characters\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        legitimate_name in suspicious_name\n",
        "        and suspicious_name != legitimate_name\n",
        "    ):\n",
        "\n",
        "        score += 4\n",
        "        reasons.append(\"Additional characters\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # Hyphenation\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    if \"-\" in suspicious_name:\n",
        "\n",
        "        without_hyphen = suspicious_name.replace(\"-\", \"\")\n",
        "\n",
        "        if (\n",
        "            legitimate_name in without_hyphen\n",
        "            or without_hyphen in legitimate_name\n",
        "        ):\n",
        "\n",
        "            score += 4\n",
        "            reasons.append(\"Hyphenation\")\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # Misleading prefix\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    prefixes = [\n",
        "        \"secure\",\n",
        "        \"login\",\n",
        "        \"verify\",\n",
        "        \"verification\",\n",
        "        \"account\",\n",
        "        \"support\",\n",
        "        \"update\"\n",
        "    ]\n",
        "\n",
        "    for prefix in prefixes:\n",
        "\n",
        "        if suspicious_name == prefix + legitimate_name:\n",
        "            score += 4\n",
        "            reasons.append(\n",
        "                f\"Misleading prefix: {prefix}\"\n",
        "            )\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # Misleading suffix\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    suffixes = [\n",
        "        \"secure\",\n",
        "        \"login\",\n",
        "        \"support\",\n",
        "        \"verification\",\n",
        "        \"update\",\n",
        "        \"official\"\n",
        "    ]\n",
        "\n",
        "    for suffix in suffixes:\n",
        "\n",
        "        if suspicious_name == legitimate_name + suffix:\n",
        "            score += 4\n",
        "            reasons.append(\n",
        "                f\"Misleading suffix: {suffix}\"\n",
        "            )\n",
        "\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # General character similarity\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    difference = character_difference(\n",
        "        suspicious_name,\n",
        "        legitimate_name\n",
        "    )\n",
        "\n",
        "    max_length = max(\n",
        "        len(suspicious_name),\n",
        "        len(legitimate_name)\n",
        "    )\n",
        "\n",
        "    if max_length > 0:\n",
        "\n",
        "        similarity = (\n",
        "            1 - difference / max_length\n",
        "        )\n",
        "\n",
        "        if similarity >= 0.75:\n",
        "\n",
        "            score += 3\n",
        "            reasons.append(\n",
        "                \"High character similarity\"\n",
        "            )\n",
        "\n",
        "    return score, reasons\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# FIND CLOSEST LEGITIMATE DOMAIN\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def analyze_domains():\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for suspicious in suspicious_domains:\n",
        "\n",
        "        best_domain = None\n",
        "        best_score = 0\n",
        "        best_reasons = []\n",
        "\n",
        "        for legitimate in legitimate_domains:\n",
        "\n",
        "            score, reasons = similarity_score(\n",
        "                suspicious,\n",
        "                legitimate\n",
        "            )\n",
        "\n",
        "            if score > best_score:\n",
        "\n",
        "                best_score = score\n",
        "                best_domain = legitimate\n",
        "                best_reasons = reasons\n",
        "\n",
        "        results.append({\n",
        "            \"suspicious\": suspicious,\n",
        "            \"legitimate\": best_domain,\n",
        "            \"score\": best_score,\n",
        "            \"reasons\": best_reasons\n",
        "        })\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# DISPLAY RESULTS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"DOMAIN LOOK-ALIKE ANALYSIS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "results = analyze_domains()\n",
        "\n",
        "for result in results:\n",
        "\n",
        "    print(\"\\nSuspicious Domain :\",\n",
        "          result[\"suspicious\"])\n",
        "\n",
        "    print(\"Closest Legitimate :\",\n",
        "          result[\"legitimate\"])\n",
        "\n",
        "    print(\"Similarity Score   :\",\n",
        "          result[\"score\"])\n",
        "\n",
        "    if result[\"reasons\"]:\n",
        "\n",
        "        print(\"Detected Patterns:\")\n",
        "\n",
        "        for reason in result[\"reasons\"]:\n",
        "            print(\"  -\", reason)\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"Detected Patterns: None\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SHORTLIST\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"FORENSIC SHORTLIST\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for result in results:\n",
        "\n",
        "    if result[\"score\"] >= 3:\n",
        "\n",
        "        print(\n",
        "            f\"{result['suspicious']:<35} \"\n",
        "            f\"→ {result['legitimate']:<20} \"\n",
        "            f\"Score: {result['score']}\"\n",
        "        )\n",
        "\n",
        "print(\"\\nAnalysis completed.\")"
      ]
    }
